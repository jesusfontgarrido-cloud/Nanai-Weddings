---
/**
 * Nuestra recomendación (dossier para parejas, «No nos entendáis mal…»). Una nota honesta
 * entre filetes, con la voz de Nanai: aconsejamos, pero decidís vosotros.
 */
import { advice } from '../../data/copy';
---

<section class="sec fadvice" aria-labelledby="advice-title">
  <div class="wrap fadvice__inner" data-reveal>
    <h2 id="advice-title" class="label fadvice__label">{advice.title}</h2>
    <p class="fadvice__text">{advice.text}</p>
  </div>
</section>

<style>
  .fadvice { padding-block: clamp(48px, 6vw, 96px); }

  .fadvice__inner {
    display: grid;
    gap: 16px;
    padding-block: clamp(24px, 3vw, 40px);
    border-top: 3px solid var(--f-yellow);
    border-bottom: var(--f-hair) solid var(--f-line-strong);
  }

  .fadvice__label { color: var(--f-on-surface); }

  .fadvice__text {
    max-width: 44ch;
    font-family: var(--font-serif);
    font-size: clamp(24px, 2.4vw, 36px);
    font-style: italic;
    line-height: 1.25;
    text-wrap-style: pretty;
  }

  @media (min-width: 1024px) {
    .fadvice__inner { grid-template-columns: 1fr 3fr; }
  }
</style>
