---
/**
 * Hero, como la portada del dossier para planners: la imagen a toda la pantalla y el
 * titular abajo a la izquierda, en blanco sobre una sombra que solo oscurece esa esquina.
 * Primera línea en League Spartan; la segunda, en Playfair cursiva, con «contamos»
 * subrayado en amarillo. Abajo a la derecha, la puerta para los profesionales.
 *
 * PROVISIONAL: fotograma del dossier para planners (2880 × 1226). Lo ideal es un bucle de
 * vídeo sin sonido de 8–15 s (≤ 6 MB, con póster): ver docs/recursos-pendientes.md. Si se
 * pasa `loop`, se usa el vídeo y la foto queda de póster.
 */
import { getImage } from 'astro:assets';
import heroImage from '../../assets/media/provisional/fotograma-beso-chaqueta-charra.jpg';
import heroTall from '../../assets/media/provisional/fotograma-beso-vertical.jpg';
import { hero } from '../../data/copy';
import { site } from '../../data/site';

interface Props {
  /** Bucle del hero (mp4/webm en /public/media). */
  loop?: string;
}

const { loop } = Astro.props;

// En pantallas verticales, un recorte vertical propio (si no, la foto apaisada se estira).
const wide = [1024, 1440, 1920, 2560];
const tall = [540, 690];
const set = async (format: 'avif' | 'webp') => ({
  wide: (await Promise.all(wide.map((width) => getImage({ src: heroImage, format, width })))).map((img, i) => `${img.src} ${wide[i]}w`).join(', '),
  tall: (await Promise.all(tall.map((width) => getImage({ src: heroTall, format, width })))).map((img, i) => `${img.src} ${tall[i]}w`).join(', '),
});
const avif = await set('avif');
const webp = await set('webp');
const fallback = await getImage({ src: heroImage, format: 'jpg', width: 1920 });
const portrait = '(max-aspect-ratio: 2/3)';
const wideSizes = '(max-aspect-ratio: 3/2) 150vh, 100vw';
---

<section class="fhero" aria-labelledby="hero-title" data-hero>
  <figure class="fhero__photo" data-reveal="focus">
    {
      loop ? (
        <video src={loop} poster={fallback.src} autoplay muted loop playsinline preload="metadata" aria-hidden="true" />
      ) : (
        <picture>
          <source media={portrait} type="image/avif" srcset={avif.tall} sizes="100vw" />
          <source media={portrait} type="image/webp" srcset={webp.tall} sizes="100vw" />
          <source type="image/avif" srcset={avif.wide} sizes={wideSizes} />
          <source type="image/webp" srcset={webp.wide} sizes={wideSizes} />
          <img
            src={fallback.src}
            width={heroImage.width}
            height={heroImage.height}
            alt="Beso de los novios entre burbujas a la salida de la ceremonia; él lleva una chaqueta charra bordada en oro"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      )
    }
  </figure>
  <span class="fhero__shade" aria-hidden="true"></span>

  <div class="wrap fhero__content">
    <h1 id="hero-title" class="fhero__h1">
      <span class="label fhero__label" data-reveal>{hero.label}</span>
      <span class="display fhero__title" data-reveal="lines" style="--i: 1">
        <span>Vosotros la vivís,</span>
        <span class="accent">nosotros la <span class="fhero__line">contamos</span></span>
      </span>
    </h1>

    <div class="fhero__actions" data-reveal style="--i: 4">
      <a class="btn btn--white" href="#tarifas">
        Ver tarifas
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
      <a class="btn btn--ghost" href={site.whatsapp}>WhatsApp</a>
    </div>
  </div>

  <a class="fhero__pro" href="/profesionales" data-reveal style="--i: 6">
    <span>{hero.pro.lead}</span>
    <strong>{hero.pro.link} →</strong>
  </a>
</section>

<style>
  .fhero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    background: #0D0D0D;
    color: #FFFFFF;
  }

  .fhero__photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    margin: 0;
  }

  .fhero__photo :global(picture),
  .fhero__photo :global(img),
  .fhero__photo video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 44% 30%;
  }

  /* Sombra solo en la esquina del texto */
  .fhero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgba(8, 8, 8, 0.72) 0%, rgba(8, 8, 8, 0.38) 34%, rgba(8, 8, 8, 0) 62%),
      linear-gradient(to right, rgba(8, 8, 8, 0.32), rgba(8, 8, 8, 0) 60%);
  }

  .fhero__content {
    --f-on-surface: #FFFFFF;
    display: grid;
    justify-items: start;
    gap: 22px;
    padding-top: 120px;
    padding-bottom: clamp(96px, 13vh, 140px);
  }

  .fhero__h1 {
    display: grid;
    gap: 16px;
    font-weight: inherit;
  }

  .fhero__label { color: #FFFFFF; }

  .fhero__title {
    font-size: clamp(46px, 6.6vw, 118px);
    color: #FFFFFF;
  }

  .fhero__title > span { display: block; }

  /* La segunda línea, en cursiva: es la que se recuerda */
  .fhero__title .accent { line-height: 1.02; }

  /* «contamos»: subrayado amarillo por debajo de la letra (el blanco no se lee sobre amarillo) */
  .fhero__line {
    padding-bottom: 0.06em;
    background: linear-gradient(var(--f-yellow), var(--f-yellow)) 0 100% / 100% 0.075em no-repeat;
  }

  html.motion .fhero__line {
    background-size: 0 0.075em;
    transition: background-size 1200ms var(--f-ease-out) 900ms;
  }

  html.motion .is-in .fhero__line { background-size: 100% 0.075em; }

  .fhero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }

  /* La puerta para los profesionales: amarilla, abajo a la derecha */
  .fhero__pro {
    position: absolute;
    right: var(--f-gutter);
    bottom: clamp(24px, 4vh, 40px);
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    align-items: center;
    max-width: calc(100% - 2 * var(--f-gutter));
    min-height: 44px;
    padding: 9px 16px;
    background: var(--f-yellow);
    color: #111111;
    font-size: 15px;
    text-decoration: none;
    transition: background-color var(--f-dur) var(--f-ease), color var(--f-dur) var(--f-ease);
  }

  .fhero__pro strong { font-weight: 700; }
  .fhero__pro:hover { background: #FFFFFF; }

  @media (max-width: 699px) {
    .fhero__photo :global(img) { object-position: 50% 30%; }
    .fhero__content { padding-bottom: 116px; }
    .fhero__title { font-size: clamp(40px, 11.4vw, 60px); }
    .fhero__pro { left: var(--f-gutter); right: var(--f-gutter); justify-content: space-between; }
  }
</style>
