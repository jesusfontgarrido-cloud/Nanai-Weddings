---
/**
 * Contacto: «¿Tenéis fecha?». A la izquierda, los tres canales —WhatsApp (el principal),
 * correo y teléfono—; a la derecha, el formulario en un panel claro.
 *
 * Lo que hace falta para responder con disponibilidad y presupuesto sin ir y venir
 * (fecha, lugar, invitados, servicio) y un campo libre. Si en la página hay calculadora,
 * su selección llega sola («nanai:selection»).
 *
 * RGPD: FlatConsent (casilla desmarcada y obligatoria y primera capa). El envío lo hace
 * FlatScripts con Web3Forms, sin salir de la página. En desarrollo no envía.
 */
import FlatEm from './FlatEm.astro';
import FlatConsent from './FlatConsent.astro';
import { contact } from '../../data/copy';
import { guestOptions, services } from '../../data/pricing';
import { site } from '../../data/site';
---

<section id="contacto" class="sec fcontact" aria-labelledby="contact-title">
  <div class="wrap fcontact__grid">
    <div class="fcontact__intro">
      <h2 id="contact-title" class="h2 fcontact__title" data-reveal="lines"><span><FlatEm text={contact.title} /></span></h2>
      <p class="lead fcontact__lead" data-reveal style="--i: 2">{contact.lead}</p>

      <div class="fcontact__channels" data-reveal style="--i: 3">
        <a class="btn fcontact__wa" href={site.whatsapp}>
          Escribidnos por WhatsApp
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
        </a>
        <a class="fcontact__line" href={`mailto:${site.email}`}>
          <span class="label">Correo</span>
          <span>{site.email}</span>
        </a>
        <a class="fcontact__line" href={site.phoneHref}>
          <span class="label">Llamadnos</span>
          <span>{site.phone}</span>
        </a>
      </div>
    </div>

    <form class="fcontact__form" action="https://api.web3forms.com/submit" method="POST" data-flat-form data-contact-form data-reveal style="--i: 2">
      <p class="label fcontact__form-head">{contact.form}</p>

      <input type="hidden" name="access_key" value={site.web3formsKey} />
      <input type="hidden" name="subject" value="Nueva consulta de boda · web de Nanai Weddings" />
      <input type="hidden" name="pagina" value={Astro.url.pathname} />
      <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" hidden />

      <fieldset class="fcontact__kind">
        <legend class="ffield__label">¿Qué os interesa?</legend>
        <div class="fcontact__chips">
          {
            services.map((service) => (
              <label class="fchip">
                <input type="radio" name="servicio" value={service.name} data-service={service.id} checked={service.id === 'pack'} />
                <span class="chip">{service.name}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <label class="ffield fcontact__selection" data-selection hidden>
        <span class="ffield__label">Vuestra selección en la calculadora</span>
        <input type="text" name="seleccion" readonly data-selection-input />
      </label>

      <label class="ffield">
        <span class="ffield__label">Vuestros nombres</span>
        <input type="text" name="nombres" autocomplete="name" required />
      </label>

      <div class="fcontact__row">
        <label class="ffield">
          <span class="ffield__label">Email</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <label class="ffield">
          <span class="ffield__label">Teléfono <span class="ffield__opt">(opcional)</span></span>
          <input type="tel" name="telefono" autocomplete="tel" />
        </label>
      </div>

      <div class="fcontact__row">
        <label class="ffield">
          <span class="ffield__label">Fecha de la boda</span>
          <input type="text" name="fecha" placeholder={contact.placeholders.date} />
        </label>
        <label class="ffield">
          <span class="ffield__label">Invitados</span>
          <select name="invitados" data-guests>
            <option value="">Aún no lo sabemos</option>
            {
              guestOptions.map((option) => (
                <option value={option.label} data-guest-id={option.id}>{option.label}</option>
              ))
            }
          </select>
        </label>
      </div>

      <label class="ffield">
        <span class="ffield__label">Dónde</span>
        <input type="text" name="lugar" placeholder={contact.placeholders.place} />
      </label>

      <label class="ffield">
        <span class="ffield__label">Contadnos <span class="ffield__opt">(opcional)</span></span>
        <textarea name="historia" rows="3" placeholder={contact.placeholders.story}></textarea>
      </label>

      <FlatConsent id="contact-consent" />

      <button class="btn fcontact__submit" type="submit">
        Enviar
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </button>

      <p class="note" role="status" data-flat-note>{contact.note}</p>
    </form>
  </div>
</section>

<script>
  // La selección de la calculadora llega al formulario.
  document.addEventListener('nanai:selection', (event) => {
    const detail = (event as CustomEvent<{ service: string; summary: string; guests?: string; detailed: boolean }>).detail;
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form) return;
    const radio = form.querySelector<HTMLInputElement>(`input[data-service="${detail.service}"]`);
    if (radio) radio.checked = true;

    const box = form.querySelector<HTMLElement>('[data-selection]');
    const input = form.querySelector<HTMLInputElement>('[data-selection-input]');
    if (box && input && detail.detailed) {
      input.value = detail.summary;
      box.hidden = false;
    }

    if (detail.guests) {
      const option = form.querySelector<HTMLOptionElement>(`option[data-guest-id="${detail.guests}"]`);
      const select = form.querySelector<HTMLSelectElement>('[data-guests]');
      if (option && select) select.value = option.value;
    }
  });
</script>

<style>
  .fcontact__grid {
    display: grid;
    gap: clamp(40px, 5vw, 80px);
  }

  .fcontact__intro {
    display: grid;
    align-content: start;
    gap: 20px;
  }

  .fcontact__title { font-size: clamp(52px, 6.4vw, 112px); }
  .fcontact__title > span { display: block; }
  .fcontact__lead { max-width: 34ch; color: var(--f-muted); }

  .fcontact__channels {
    display: grid;
    justify-items: start;
    gap: 6px;
    margin-top: 10px;
  }

  .fcontact__wa { min-height: 56px; margin-bottom: 10px; padding-inline: 26px; font-size: 17px; }

  .fcontact__line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    min-height: 44px;
    padding-top: 10px;
    color: var(--f-on-surface);
    font-size: 18px;
    text-decoration: none;
  }

  .fcontact__line .label { min-width: 9ch; color: var(--f-muted); }
  .fcontact__line:hover span:last-child { text-decoration: underline; text-underline-offset: 0.2em; }

  /* El formulario, en un panel claro y redondeado */
  .fcontact__form {
    display: grid;
    gap: 18px;
    padding: clamp(22px, 3vw, 40px);
    border: var(--f-hair) solid var(--f-line);
    border-radius: var(--f-r-card);
    background: linear-gradient(160deg, #FFFFFF, #F6F6F5);
    box-shadow: var(--f-shadow);
  }

  .fcontact__form-head { color: var(--f-on-surface); }

  .fcontact__kind {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .fcontact__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .fcontact__row { display: grid; gap: 18px; }

  .fcontact__selection input { font-size: 15px; font-weight: 600; }

  .fcontact__submit { justify-self: start; }

  @media (min-width: 768px) {
    .fcontact__row { grid-template-columns: 1fr 1fr; }
  }

  @media (min-width: 1024px) {
    .fcontact__grid { grid-template-columns: 1fr 1.1fr; }
  }
</style>
