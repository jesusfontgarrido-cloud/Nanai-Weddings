---
/**
 * Barra superior (la de Nanai Studio): logo a la izquierda, páginas numeradas en el centro
 * (la activa entre esquinas de encuadre) y, a la derecha, dos botones: «Profesionales»
 * (contorno: la puerta para wedding planners, fincas y proveedores) y «Consultar fecha»
 * con el punto de REC, el único relleno. Su filo inferior es la línea de progreso en rojo.
 * En móvil: «Menú» abre una hoja a pantalla completa con WhatsApp a mano.
 */
import { site } from '../../data/site';
import FlatWordmark from './FlatWordmark.astro';

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/historias', label: 'Historias' },
  { href: '/tarifas', label: 'Tarifas' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (path === href || (href !== '/' && path.startsWith(`${href}/`)) ? ('page' as const) : undefined);
const onPro = path.startsWith('/profesionales');
// En la página de profesionales, el botón principal lleva a su propio contacto.
const cta = onPro
  ? { href: '#contacto', label: 'Hablemos', short: 'Hablemos' }
  : { href: path === '/' ? '#contacto' : '/#contacto', label: 'Consultar fecha', short: 'Hablemos' };
---

<header class="fnav">
  <div class="fnav__bar">
    <a class="fnav__logo" href="/" aria-label="Nanai Weddings, inicio">
      <FlatWordmark />
    </a>

    <nav class="fnav__links" aria-label="Principal">
      <ul role="list">
        {
          links.map((link, i) => (
            <li>
              <a href={link.href} aria-current={current(link.href)}>
                <span class="fnav__idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="fnav__actions">
      <a class="fnav__pro" href="/profesionales" aria-current={onPro ? 'page' : undefined}>Profesionales</a>
      <a class="fnav__cta" href={cta.href}>
        <span class="fnav__dot" aria-hidden="true"></span>
        <span class="fnav__cta-long">{cta.label}</span><span class="fnav__cta-short" aria-hidden="true">{cta.short}</span>
      </a>
      <button class="fnav__menu" type="button" popovertarget="flat-menu">Menú</button>
    </div>
  </div>
</header>

<div id="flat-menu" class="fmenu" popover>
  <div class="fmenu__head">
    <FlatWordmark />
    <button class="fmenu__close" type="button" popovertarget="flat-menu" popovertargetaction="hide">Cerrar</button>
  </div>

  <nav aria-label="Principal (móvil)">
    <ul class="fmenu__list" role="list">
      {
        links.map((link, i) => (
          <li>
            <a href={link.href} aria-current={current(link.href)}>
              <span class="fmenu__idx">{String(i + 1).padStart(2, '0')}</span>
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="/#contacto">
          <span class="fmenu__idx">04</span>
          Consultar fecha
        </a>
      </li>
    </ul>
  </nav>

  <!-- Atajos de contacto: en móvil, WhatsApp es lo más rápido -->
  <div class="fmenu__direct">
    <a class="fmenu__pro" href="/profesionales">
      <span>¿Wedding planner, finca o proveedor?</span>
      <strong>Profesionales →</strong>
    </a>
    <a class="fmenu__wa" href={site.whatsapp}>
      <span class="fmenu__dot" aria-hidden="true"></span>
      Escribidnos por WhatsApp
    </a>
    <a class="fmenu__mail" href={`mailto:${site.email}`}>{site.email}</a>
  </div>
</div>

<script>
  // Un enlace de ancla no cierra el popover por sí solo.
  const menu = document.getElementById('flat-menu');
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      try {
        (menu as HTMLElement & { hidePopover(): void }).hidePopover();
      } catch {
        // Navegador sin popover o menú ya cerrado.
      }
    });
  });
</script>

<style>
  .fnav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
  }

  .fnav__bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 60px;
    padding: 8px var(--f-gutter);
    border-bottom: var(--f-hair) solid rgba(20, 20, 18, 0.12);
    background: rgba(246, 243, 238, 0.94);
    color: #151514;
    view-transition-name: fnav;
  }

  @supports (animation-timeline: scroll()) {
    .fnav__bar::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: -1px;
      height: 2px;
      background: var(--f-red);
      transform: scaleX(0);
      transform-origin: left center;
      animation: fnav-progress linear both;
      animation-timeline: scroll(root block);
    }

    @keyframes fnav-progress {
      to { transform: scaleX(1); }
    }
  }

  .fnav__logo {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
  }

  .fnav__logo { color: #151514; text-decoration: none; }

  .fnav__links { flex: 1; }

  .fnav__links ul {
    display: flex;
    justify-content: center;
    gap: 6px;
  }

  .fnav__links a,
  .fnav__cta,
  .fnav__menu {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
  }

  .fnav__cta { font-weight: 600; }
  .fnav__cta-short { display: none; }

  /* Profesionales: botón de contorno, la puerta para el sector */
  .fnav__pro {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding-inline: 14px;
    border: var(--f-hair) solid rgba(20, 20, 18, 0.34);
    border-radius: var(--f-r);
    color: #151514;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color var(--f-dur) var(--f-ease), background-color var(--f-dur) var(--f-ease);
  }

  .fnav__pro:hover,
  .fnav__pro[aria-current='page'] { border-color: #151514; }

  .fnav__pro[aria-current='page'] { background: rgba(20, 20, 18, 0.06); }

  .fnav__links a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding-inline: 12px;
    color: #55554F;
    text-decoration: none;
    transition: color var(--f-dur) var(--f-ease);
  }

  .fnav__idx { color: #6A6A63; }

  /* Esquinas de encuadre: aparecen al pasar y fijan la página activa */
  .fnav__links a::before,
  .fnav__links a::after {
    content: '';
    position: absolute;
    width: 7px;
    height: 7px;
    border: 0 solid currentColor;
    opacity: 0;
    transition: opacity var(--f-dur) var(--f-ease);
  }

  .fnav__links a::before { top: 6px; left: 2px; border-top-width: 1px; border-left-width: 1px; }
  .fnav__links a::after { bottom: 6px; right: 2px; border-bottom-width: 1px; border-right-width: 1px; }

  .fnav__links a:hover,
  .fnav__links a[aria-current='page'] { color: #151514; }

  .fnav__links a:hover::before,
  .fnav__links a:hover::after,
  .fnav__links a[aria-current='page']::before,
  .fnav__links a[aria-current='page']::after { opacity: 1; }

  .fnav__links a[aria-current='page'] .fnav__idx { color: var(--f-red-text); }

  .fnav__actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* Hablemos: el único botón relleno de la barra, con el punto de REC */
  .fnav__cta {
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding-inline: 16px;
    border-radius: var(--f-r);
    background: #151514;
    color: #F6F3EE;
    text-decoration: none;
    transition: background-color var(--f-dur) var(--f-ease);
  }

  .fnav__cta:hover { background: var(--f-red); }

  .fnav__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--f-red);
    animation: fnav-rec 1.6s steps(1) infinite;
  }

  .fnav__cta:hover .fnav__dot { background: #FFFFFF; }

  @keyframes fnav-rec {
    50% { opacity: 0.25; }
  }

  .fnav__menu {
    display: none;
    align-items: center;
    min-height: 40px;
    padding-inline: 14px;
    border: var(--f-hair) solid rgba(20, 20, 18, 0.34);
    border-radius: var(--f-r);
    background: transparent;
    color: #151514;
    cursor: pointer;
  }

  /* Menú a pantalla completa (móvil) */
  .fmenu {
    display: none;
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 12px max(16px, var(--f-gutter)) 28px;
    border: 0;
    background: #F6F3EE;
    color: #151514;
  }

  .fmenu:popover-open {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 28px;
  }

  .fmenu__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 48px;
  }

  .fmenu__pro {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 6px 16px;
    min-height: 56px;
    padding: 12px 16px;
    border: var(--f-hair) solid rgba(20, 20, 18, 0.34);
    border-radius: var(--f-r);
    color: #151514;
    font-size: 15px;
    text-decoration: none;
  }

  .fmenu__close {
    min-height: 44px;
    padding-inline: 16px;
    border: var(--f-hair) solid rgba(20, 20, 18, 0.34);
    border-radius: var(--f-r);
    background: transparent;
    color: inherit;
    font-family: var(--font-type);
    font-size: 14px;
    cursor: pointer;
  }

  .fmenu__list {
    display: grid;
    align-content: center;
    border-top: var(--f-hair) solid rgba(20, 20, 18, 0.14);
  }

  .fmenu__list a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    min-height: 72px;
    padding: 16px 4px;
    border-bottom: var(--f-hair) solid rgba(20, 20, 18, 0.14);
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 620;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  .fmenu__idx {
    color: #6A6A63;
    font-family: var(--font-type);
    font-size: 14px;
  }

  .fmenu__list a[aria-current='page'] .fmenu__idx { color: var(--f-red-text); }

  .fmenu__direct {
    display: grid;
    gap: 14px;
  }

  .fmenu__wa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 56px;
    border-radius: var(--f-r);
    background: var(--f-red);
    color: #FFFFFF;
    font-size: 17px;
    font-weight: 600;
    text-decoration: none;
  }

  .fmenu__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }

  .fmenu__mail {
    justify-self: center;
    min-height: 32px;
    color: #55554F;
    font-size: 16px;
  }

  @media (max-width: 899px) {
    .fnav__links { display: none; }
    .fnav__pro { display: none; }
    .fnav__bar { justify-content: space-between; }
    .fnav__menu { display: inline-flex; }
  }

  /* En móvil, el botón corto (como en Studio) para que quepa junto al logotipo */
  @media (max-width: 520px) {
    .fnav__cta-long { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .fnav__cta-short { display: inline; }
  }

  @media (max-width: 420px) {
    .fnav__cta { padding-inline: 12px; }
    .fnav__logo :global(.wordmark) { font-size: 19px; }
  }

  @media (max-width: 360px) {
    .fnav__dot { display: none; }
  }
</style>
