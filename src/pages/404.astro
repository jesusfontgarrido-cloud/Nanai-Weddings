---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Página no encontrada | Nanai Weddings" noindex>
  <section class="sec f404">
    <div class="wrap f404__inner">
      <p class="label">Error 404</p>
      <h1 class="display f404__title">Esta página <em class="accent">no</em> salió en el montaje</h1>
      <p class="lead f404__lead">Puede que el enlace haya cambiado. Volved al inicio o mirad las tarifas.</p>
      <p class="f404__links"><a class="btn" href="/">Ir al inicio</a> <a class="btn btn--line" href="/tarifas">Ver tarifas</a></p>
    </div>
  </section>
</SiteLayout>

<style>
  .f404 { padding-top: clamp(140px, 22vh, 240px); }
  .f404__inner { display: grid; justify-items: center; gap: 18px; text-align: center; }
  .f404__title { max-width: 14ch; font-size: clamp(48px, 7vw, 120px); }
  .f404__lead { color: var(--f-muted); }
  .f404__links { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 12px; }
</style>
