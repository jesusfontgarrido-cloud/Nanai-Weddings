---
/**
 * Proceso: del primer mensaje a la entrega, en cinco pasos. Una banda gris a sangre con
 * los pasos en columnas, numerados en grande y con filete arriba, como las condiciones
 * del dossier. El día de la boda va subrayado en amarillo. Sin interacción: se lee todo.
 */
import { process } from '../../data/copy';
---

<section class="sec tone-gray fsteps-sec" aria-labelledby="steps-title">
  <div class="wrap fsteps">
    <div class="fsteps__head" data-reveal>
      <p class="label">{process.label}</p>
      <h2 id="steps-title" class="h2 fsteps__title">{process.title}</h2>
      <p class="fsteps__deck">{process.deck}</p>
    </div>

    <ol class="fsteps__list" role="list" data-stagger>
      {
        process.steps.map((step, i) => (
          <li class:list={['fstep', { 'fstep--key': 'key' in step && step.key }]}>
            <span class="fstep__num" aria-hidden="true">{i + 1}</span>
            <h3 class="fstep__name"><span>{step.name}</span></h3>
            <p class="fstep__text">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .fsteps { display: grid; gap: clamp(36px, 4vw, 56px); }
  .fsteps__head { display: grid; gap: 12px; }
  .fsteps__title { font-size: clamp(30px, 3vw, 46px); }
  .fsteps__deck { max-width: 52ch; color: var(--f-muted); }

  .fsteps__list { display: grid; gap: 28px var(--f-gap); }

  .fstep {
    display: grid;
    align-content: start;
    gap: 8px;
    padding-top: 16px;
    border-top: 2px solid var(--f-on-surface);
  }

  .fstep__num {
    font-family: var(--font-serif);
    font-size: clamp(44px, 4vw, 64px);
    font-style: italic;
    font-weight: 400;
    line-height: 1;
  }

  .fstep__name {
    font-family: var(--font-display);
    font-size: clamp(20px, 1.6vw, 24px);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .fstep--key .fstep__name span {
    background: linear-gradient(var(--f-yellow), var(--f-yellow)) 0 85% / 100% 0.4em no-repeat;
  }

  .fstep__text {
    max-width: 30ch;
    color: var(--f-muted);
    font-size: 16px;
    line-height: 1.5;
  }

  @media (min-width: 700px) {
    .fsteps__list { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .fsteps__list { grid-template-columns: repeat(5, 1fr); }
  }
</style>
