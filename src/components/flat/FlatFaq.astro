---
/**
 * Preguntas (el componente de Nanai Studio). El plano rojo de la página: la única banda
 * en rojo. Aquí viven las condiciones —reserva, pagos, cancelación, horas, entrega,
 * desplazamiento—, justo antes del contacto. Admite una lista suelta o grupos.
 */
import type { Faq, FaqGroup } from '../../data/faq';

interface Props {
  items?: Faq[];
  groups?: FaqGroup[];
  id?: string;
  title?: [string, string];
  /** Enlace bajo el titular (home: a todas las condiciones). */
  more?: { href: string; label: string };
  /** Texto bajo el titular. */
  deck?: string;
  /** Rojo por defecto: el plano rojo de la página. En papel si la página ya lo usa. */
  tone?: 'red' | 'paper';
}

const {
  items = [],
  groups,
  id = 'preguntas',
  title = ['Antes de escribirnos,', 'quizá os preguntáis…'],
  more,
  deck,
  tone = 'red',
} = Astro.props;
const blocks: FaqGroup[] = groups ?? [{ id: 'todas', title: '', items }];
---

<section id={id} class:list={['sec', 'ffaq', { 'tone-red': tone === 'red' }]} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <div class="ffaq__grid">
      <div class="ffaq__head">
        <h2 id={`${id}-title`} class="h2 ffaq__title" data-reveal="lines">
          <span>{title[0]}</span>
          <span class="ffaq__title-2">{title[1]}</span>
        </h2>
        {deck && <p class="ffaq__deck" data-reveal style="--i: 2">{deck}</p>}
        {more && <a class="link ffaq__more" href={more.href} data-reveal style="--i: 3">{more.label} →</a>}
      </div>

      <div class="ffaq__blocks">
        {
          blocks.map((block) => (
            <div class="ffaq__block" id={groups ? `${id}-${block.id}` : undefined}>
              {block.title && <h3 class="label ffaq__group">{block.title}</h3>}
              <div class="ffaq__list" data-stagger>
                {block.items.map((item) => (
                  <details class="ffaq__item">
                    <summary class="ffaq__q">
                      <span>{item.q}</span>
                      <span class="ffaq__icon" aria-hidden="true" />
                    </summary>
                    <p class="ffaq__a">{item.a}</p>
                  </details>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .ffaq__grid {
    display: grid;
    gap: 28px;
  }

  .ffaq__head { display: grid; align-content: start; gap: 18px; }
  .ffaq__title > span { display: block; }
  .ffaq__title-2 { opacity: 0.78; }
  .ffaq__deck { max-width: 40ch; }
  .ffaq__more { justify-self: start; }

  .ffaq__blocks { display: grid; gap: 36px; }

  .ffaq__group {
    margin-bottom: 10px;
    color: var(--f-on-surface);
    font-weight: 700;
  }

  .ffaq__list {
    display: grid;
    border-top: var(--f-hair) solid var(--f-line);
  }

  .ffaq__item { border-bottom: var(--f-hair) solid var(--f-line); }

  .ffaq__q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    min-height: 60px;
    padding: 14px 10px;
    font-size: 18px;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
    transition: padding-left 320ms var(--f-ease-out);
  }

  .ffaq__q:hover { padding-left: 16px; }
  .ffaq__q::-webkit-details-marker { display: none; }

  .ffaq__icon {
    position: relative;
    flex: none;
    width: 20px;
    height: 20px;
  }

  .ffaq__icon::before,
  .ffaq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: translateY(-50%);
    transition: transform var(--f-dur) var(--f-ease);
  }

  .ffaq__icon::after { transform: translateY(-50%) rotate(90deg); }
  .ffaq__item[open] .ffaq__icon::after { transform: translateY(-50%) rotate(0deg); }

  .ffaq__a {
    max-width: 62ch;
    padding: 0 10px 20px;
    color: var(--f-muted);
  }

  @media (min-width: 900px) {
    .ffaq__grid { grid-template-columns: 1fr 1.25fr; gap: 48px; }
    .ffaq__head { position: sticky; top: 100px; align-self: start; }
  }
</style>
