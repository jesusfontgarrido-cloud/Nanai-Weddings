---
/**
 * Página de una boda. Estructura de las mejores webs de bodas (Vashchenko, WedJrny) con la
 * jerarquía de créditos de cine de Nanai: el nombre grande, la cartela (lugar, fecha,
 * servicio, equipo), la película, la galería por momentos (25–40 fotos, en orden), lo que
 * dijeron y los proveedores (bueno para las wedding planners y para el SEO local).
 * Todo lo que falta, en huecos marcados.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlatMotion from '../../components/flat/FlatMotion.astro';
import FlatNav from '../../components/flat/FlatNav.astro';
import FlatFilm from '../../components/flat/FlatFilm.astro';
import FlatPh from '../../components/flat/FlatPh.astro';
import FlatContact from '../../components/flat/FlatContact.astro';
import FlatFooter from '../../components/flat/FlatFooter.astro';
import { stories, storyChapters, type Story } from '../../data/stories';

export function getStaticPaths() {
  return stories.map((story, i) => ({ params: { slug: story.slug }, props: { story, next: stories[(i + 1) % stories.length] } }));
}

interface Props {
  story: Story;
  next: Story;
}

const { story, next } = Astro.props;

// Formatos de la galería, en un ritmo que alterna vertical y horizontal (revista)
const rhythm = ['4 / 5', '3 / 2', '4 / 5', '4 / 5', '3 / 2', '1 / 1'];
const credits = [
  { role: 'Lugar', value: story.place },
  { role: 'Fecha', value: story.date },
  { role: 'Servicio', value: story.services },
  { role: 'Equipo', value: '[Fotografía y vídeo: nombres]' },
];
const vendors = ['Wedding planner', 'Finca', 'Flores', 'Vestido', 'Traje', 'Maquillaje y peluquería', 'Música'];
---

<BaseLayout
  title={`${story.couple} · Historia | Nanai Weddings`}
  description={`La boda de ${story.couple} en ${story.place}, contada en foto y vídeo por Nanai Weddings.`}
  path={`/historias/${story.slug}`}
  noindex={story.pending}
>
  <div class="flat">
    <FlatMotion />
    <FlatNav />

    <main id="contenido">
      <section class="sec fcase-head" aria-labelledby="case-title">
        <div class="wrap fcase-head__inner">
          <a class="link fcase-head__back" href="/historias" data-reveal>← Historias</a>
          <h1 id="case-title" class="fcase-head__title" data-reveal="lines"><span data-pending={story.pending ? 'text' : undefined}>{story.couple}</span></h1>
          <dl class="fcase-credits" data-stagger>
            {
              credits.map((credit) => (
                <div>
                  <dt class="label">{credit.role}</dt>
                  <dd>{credit.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <section class="sec fcase-film" aria-label="La película">
        <div class="wrap" data-reveal="focus">
          <FlatFilm vimeoId={story.vimeoId} title={`${story.couple} · tráiler`} poster={story.cover?.src} posterAlt={story.cover?.alt} ratio="2.39 / 1" pendingWhat="Tráiler de esta boda" />
        </div>
      </section>

      {
        storyChapters.map((chapter, c) => (
          <section class="sec fchapter" aria-labelledby={`chapter-${c}`}>
            <div class="wrap">
              <h2 id={`chapter-${c}`} class="fchapter__title" data-reveal>
                <span class="fchapter__num">{String(c + 1).padStart(2, '0')}</span>
                {chapter.name}
              </h2>
              <ul class="fchapter__grid" role="list" data-stagger>
                {Array.from({ length: chapter.count }, (_, i) => {
                  const ratio = rhythm[(i + c) % rhythm.length];
                  return (
                    <li class:list={['fchapter__item', { 'fchapter__item--wide': ratio === '3 / 2' }]}>
                      <FlatPh what={`${chapter.name} · foto ${i + 1}`} format={`FOTO · ${ratio.replace(/ /g, '')}`} ratio={ratio} />
                    </li>
                  );
                })}
              </ul>
            </div>
          </section>
        ))
      }

      <section class="sec fcase-quote" aria-label="Lo que nos dijeron">
        <div class="wrap fcase-quote__inner" data-reveal data-pending="review">
          <p class="quote">«Lo que nos dijeron después de ver su vídeo: una frase real de la pareja.»</p>
          <p class="label">— {story.couple} · pendiente</p>
        </div>
      </section>

      <section class="sec tone-bone fvendors" aria-labelledby="vendors-title">
        <div class="wrap">
          <h2 id="vendors-title" class="h3" data-reveal>Con quién la hicimos</h2>
          <dl class="fvendors__list" data-stagger>
            {
              vendors.map((vendor) => (
                <div>
                  <dt class="label">{vendor}</dt>
                  <dd data-pending="text">[Nombre y enlace]</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <section class="sec fcase-next" aria-label="Siguiente historia">
        <div class="wrap">
          <a class="fcase-next__link" href={`/historias/${next.slug}`}>
            <span class="label">Siguiente historia</span>
            <span class="fcase-next__name">{next.couple} →</span>
          </a>
        </div>
      </section>

      <FlatContact />
    </main>

    <FlatFooter />
  </div>
</BaseLayout>

<style>
  .fcase-head { padding-top: clamp(120px, 18vh, 200px); padding-bottom: clamp(32px, 4vw, 56px); }
  .fcase-head__inner { display: grid; gap: clamp(20px, 2.4vw, 32px); }
  .fcase-head__back { justify-self: start; }

  /* El nombre de la pareja, en grande: la jerarquía de créditos de cine */
  .fcase-head__title {
    font-family: var(--font-serif);
    font-size: clamp(48px, 8vw, 148px);
    font-style: italic;
    font-weight: 450;
    line-height: 0.98;
    letter-spacing: -0.02em;
  }

  .fcase-head__title > span { display: block; }

  .fcase-credits {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 18px var(--f-gap);
    margin: 0;
    padding-top: 18px;
    border-top: var(--f-hair) solid var(--f-line-strong);
  }

  .fcase-credits div { display: grid; gap: 4px; }
  .fcase-credits dd { margin: 0; font-family: var(--font-display); font-size: clamp(20px, 1.8vw, 26px); font-weight: 600; letter-spacing: -0.015em; }

  .fcase-film { padding-top: 0; }

  .fchapter { padding-block: clamp(36px, 4.4vw, 72px); }

  .fchapter__title {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: clamp(20px, 2.4vw, 32px);
    font-family: var(--font-display);
    font-size: clamp(28px, 3vw, 44px);
    font-weight: 620;
    letter-spacing: -0.03em;
  }

  .fchapter__num { color: var(--f-red-text); font-family: var(--font-type); font-size: 14px; font-weight: 400; letter-spacing: 0; }

  .fchapter__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--f-gap);
    align-items: start;
  }

  .fchapter__item--wide { grid-column: span 2; }

  @media (min-width: 900px) {
    .fchapter__grid { grid-template-columns: repeat(4, 1fr); }
  }

  .fcase-quote__inner { display: grid; gap: 16px; max-width: 30ch; margin-inline: auto; text-align: center; color: var(--f-muted); }

  .fvendors__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 18px var(--f-gap);
    margin: 24px 0 0;
  }

  .fvendors__list div { display: grid; gap: 2px; padding-top: 12px; border-top: var(--f-hair) solid var(--f-line); }
  .fvendors__list dd { margin: 0; color: var(--f-muted); }

  .fcase-next__link {
    display: grid;
    gap: 8px;
    padding-block: clamp(28px, 4vw, 56px);
    border-block: var(--f-hair) solid var(--f-line-strong);
    text-decoration: none;
  }

  .fcase-next__name {
    font-family: var(--font-serif);
    font-size: clamp(36px, 5vw, 80px);
    font-style: italic;
    line-height: 1;
    transition: color var(--f-dur) var(--f-ease);
  }

  .fcase-next__link:hover .fcase-next__name { color: var(--f-red-text); }
</style>
