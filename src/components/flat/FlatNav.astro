---
/**
 * Barra superior de cristal: una píldora blanca translúcida con desenfoque, flotando
 * (sobre el hero, más transparente; al bajar, más opaca y con sombra).
 * Logotipo a la izquierda, las páginas en el centro (la activa, con un punto debajo;
 * «Historias» despliega Vídeo y Fotografía al pulsar, no al pasar el ratón) y a
 * la derecha dos botones redondeados: «Profesionales» (el único dorado de la web; abre un
 * formulario corto, la página para profesionales va aparte, por enlace) y
 * «Consultar fecha» (negro; en móvil, «Hablemos»).
 * En móvil: «Menú» abre una hoja a pantalla completa con WhatsApp a mano.
 */
import { site } from '../../data/site';
import { proDialog, storyKinds } from '../../data/copy';
import FlatWordmark from './FlatWordmark.astro';

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/historias', label: 'Historias' },
  { href: '/tarifas', label: 'Tarifas' },
];

const storyLinks = [
  { href: storyKinds.video.path, label: storyKinds.video.nav, text: 'Tráilers de boda' },
  { href: storyKinds.foto.path, label: storyKinds.foto.nav, text: 'Galerías por momentos' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (path === href || (href !== '/' && path.startsWith(`${href}/`)) ? ('page' as const) : undefined);
const cta = { href: path === '/' ? '#contacto' : '/#contacto', label: 'Consultar fecha' };
---

<header class="fnav" data-nav>
  <div class="fnav__bar">
    <a class="fnav__logo" href="/" aria-label="Nanai Weddings, inicio">
      <FlatWordmark />
    </a>

    <nav class="fnav__links" aria-label="Principal">
      <ul role="list">
        {
          links.map((link) =>
            link.href === '/historias' ? (
              <li>
                <details class="fnav__drop" data-nav-drop>
                  <summary class:list={['fnav__drop-btn', { 'is-current': current(link.href) }]}>
                    {link.label}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                  </summary>
                  <div class="fnav__drop-panel">
                    {storyLinks.map((item) => (
                      <a class="fnav__drop-link" href={item.href} aria-current={current(item.href)}>
                        <strong>{item.label}</strong>
                        <span>{item.text}</span>
                      </a>
                    ))}
                    <a class="fnav__drop-all" href="/historias" aria-current={path === '/historias' ? 'page' : undefined}>Todas las historias</a>
                  </div>
                </details>
              </li>
            ) : (
              <li>
                <a href={link.href} aria-current={current(link.href)}>{link.label}</a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="fnav__actions">
      <button class="fnav__pro" type="button" data-open-dialog="pro-dialog" aria-haspopup="dialog">{proDialog.trigger}</button>
      <a class="fnav__cta" href={cta.href}>
        <span class="fnav__cta-long">{cta.label}</span><span class="fnav__cta-short" aria-hidden="true">Hablemos</span>
      </a>
      <button class="fnav__menu" type="button" popovertarget="flat-menu">Menú</button>
    </div>
  </div>
</header>

<div id="flat-menu" class="fmenu" popover>
  <div class="fmenu__head">
    <FlatWordmark />
    <button class="fmenu__close" type="button" popovertarget="flat-menu" popovertargetaction="hide">Cerrar</button>
  </div>

  <nav aria-label="Principal (móvil)">
    <ul class="fmenu__list" role="list">
      {
        links.map((link) => (
          <li>
            <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>{link.label}</a>
            {link.href === '/historias' && (
              <span class="fmenu__sub">
                {storyLinks.map((item) => (
                  <a class="chip" href={item.href} aria-current={current(item.href)}>{item.label}</a>
                ))}
              </span>
            )}
          </li>
        ))
      }
      <li><a href="/#contacto">Consultar fecha</a></li>
    </ul>
  </nav>

  <div class="fmenu__direct">
    <a class="fmenu__wa" href={site.whatsapp}>Escribidnos por WhatsApp</a>
    <button class="fmenu__pro" type="button" data-open-dialog="pro-dialog" aria-haspopup="dialog">¿Sois profesionales del sector?</button>
    <a class="fmenu__mail" href={`mailto:${site.email}`}>{site.email}</a>
  </div>
</div>

<script>
  // Un enlace de ancla (o abrir el formulario de profesionales) no cierra el popover por sí solo.
  const menu = document.getElementById('flat-menu') as (HTMLElement & { hidePopover(): void }) | null;
  menu?.querySelectorAll('a, [data-open-dialog]').forEach((item) => {
    item.addEventListener('click', () => {
      try {
        menu.hidePopover();
      } catch {
        // Navegador sin popover o menú ya cerrado.
      }
    });
  });

  // Desplegable de Historias: uno abierto a la vez; se cierra al pulsar fuera o con Escape.
  const drops = [...document.querySelectorAll<HTMLDetailsElement>('[data-nav-drop]')];
  document.addEventListener('click', (event) => {
    drops.forEach((drop) => {
      if (drop.open && !drop.contains(event.target as Node)) drop.open = false;
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    drops.forEach((drop) => {
      if (!drop.open) return;
      drop.open = false;
      drop.querySelector('summary')?.focus();
    });
  });

  // Al bajar, el cristal se vuelve más opaco.
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const onScroll = () => nav?.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .fnav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    padding: calc(10px + env(safe-area-inset-top, 0px)) var(--f-inset) 0;
    pointer-events: none;
  }

  .fnav__bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 24px;
    max-width: var(--f-maxw);
    min-height: 62px;
    margin-inline: auto;
    padding: 8px 8px 8px calc(var(--f-gutter) - var(--f-inset));
    border: var(--f-hair) solid rgba(255, 255, 255, 0.5);
    border-radius: var(--f-r);
    background: rgba(255, 255, 255, 0.58);
    color: #111111;
    pointer-events: auto;
    -webkit-backdrop-filter: var(--f-blur);
    backdrop-filter: var(--f-blur);
    transition:
      background-color 420ms var(--f-ease-out),
      border-color 420ms var(--f-ease-out),
      box-shadow 420ms var(--f-ease-out);
    view-transition-name: fnav;
  }

  .fnav.is-scrolled .fnav__bar {
    border-color: rgba(255, 255, 255, 0.7);
    background: var(--f-glass);
    box-shadow: 0 6px 24px rgba(17, 17, 17, 0.07);
  }

  .fnav__logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #111111;
    text-decoration: none;
  }

  .fnav__links { flex: 1; }

  .fnav__links ul {
    display: flex;
    justify-content: center;
    gap: 6px;
  }

  .fnav__links > ul > li > a,
  .fnav__pro,
  .fnav__cta,
  .fnav__menu {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
  }

  /* Enlaces: pastilla translúcida al pasar; la activa, con un punto debajo */
  .fnav__links > ul > li > a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 16px;
    border-radius: var(--f-r);
    color: #555555;
    text-decoration: none;
    transition: color var(--f-dur) var(--f-ease), background-color var(--f-dur) var(--f-ease);
  }

  .fnav__links > ul > li > a:hover { background: rgba(17, 17, 17, 0.05); color: #111111; }

  .fnav__links > ul > li > a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 6px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0;
    transform: scale(0);
    transition: transform 420ms var(--f-ease-out), opacity 420ms var(--f-ease-out);
  }

  .fnav__links > ul > li > a[aria-current='page'] { color: #111111; font-weight: 600; }
  .fnav__links > ul > li > a[aria-current='page']::after { opacity: 1; transform: none; }

  /* Desplegable de Historias (details/summary: funciona sin JS) */
  .fnav__drop { position: relative; }

  .fnav__drop-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding-inline: 16px 12px;
    border-radius: var(--f-r);
    color: #555555;
    font-size: 14px;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
    transition: color var(--f-dur) var(--f-ease), background-color var(--f-dur) var(--f-ease);
  }

  .fnav__drop-btn::-webkit-details-marker { display: none; }
  .fnav__drop-btn:hover,
  .fnav__drop[open] .fnav__drop-btn { background: rgba(17, 17, 17, 0.05); color: #111111; }
  .fnav__drop-btn svg { width: 14px; height: 14px; transition: transform var(--f-dur) var(--f-ease); }
  .fnav__drop[open] .fnav__drop-btn svg { transform: rotate(180deg); }
  .fnav__drop-btn.is-current { color: #111111; font-weight: 600; }

  .fnav__drop-btn.is-current::after {
    content: '';
    position: absolute;
    left: calc(50% - 6px);
    bottom: 6px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
  }

  .fnav__drop-panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    display: grid;
    gap: 4px;
    width: 260px;
    padding: 8px;
    border: var(--f-hair) solid rgba(255, 255, 255, 0.7);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 18px 50px rgba(17, 17, 17, 0.14);
    transform: translateX(-50%);
    -webkit-backdrop-filter: var(--f-blur);
    backdrop-filter: var(--f-blur);
  }

  html.motion .fnav__drop[open] .fnav__drop-panel { animation: fnav-drop 320ms var(--f-ease-out); }

  @keyframes fnav-drop {
    from { opacity: 0; transform: translate(-50%, -6px); }
  }

  .fnav__drop-link {
    display: grid;
    gap: 2px;
    padding: 12px 14px;
    border-radius: 16px;
    color: #111111;
    text-decoration: none;
    transition: background-color var(--f-dur) var(--f-ease);
  }

  .fnav__drop-link strong { font-size: 15px; font-weight: 600; }
  .fnav__drop-link span { color: #6E6E6B; font-size: 13px; }
  .fnav__drop-link:hover,
  .fnav__drop-link[aria-current='page'] { background: rgba(17, 17, 17, 0.05); }

  .fnav__drop-all {
    display: flex;
    align-items: center;
    min-height: 44px;
    margin-top: 2px;
    padding: 0 14px;
    border-top: var(--f-hair) solid rgba(17, 17, 17, 0.08);
    color: #555555;
    font-size: 13px;
    text-decoration: none;
  }

  .fnav__drop-all:hover { color: #111111; }

  .fnav__actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* El único toque dorado de la web */
  .fnav__pro {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 18px;
    border: var(--f-hair) solid rgba(191, 160, 106, 0.55);
    border-radius: var(--f-r);
    background: linear-gradient(135deg, rgba(217, 195, 148, 0.34), rgba(191, 160, 106, 0.22));
    color: #111111;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color var(--f-dur) var(--f-ease), border-color var(--f-dur) var(--f-ease), box-shadow var(--f-dur) var(--f-ease);
  }

  .fnav__pro:hover {
    border-color: var(--f-gold);
    background: linear-gradient(135deg, var(--f-gold-light), var(--f-gold));
    box-shadow: 0 6px 18px rgba(191, 160, 106, 0.3);
  }

  /* El único botón relleno de la barra */
  .fnav__cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 20px;
    border-radius: var(--f-r);
    background: #111111;
    color: #FFFFFF;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--f-dur) var(--f-ease), box-shadow var(--f-dur) var(--f-ease);
  }

  .fnav__cta:hover { background: #2A2C30; box-shadow: 0 6px 18px rgba(17, 17, 17, 0.18); }
  .fnav__cta-short { display: none; }

  .fnav__menu {
    display: none;
    align-items: center;
    min-height: 44px;
    padding-inline: 16px;
    border: var(--f-hair) solid rgba(17, 17, 17, 0.18);
    border-radius: var(--f-r);
    background: rgba(255, 255, 255, 0.6);
    color: #111111;
    cursor: pointer;
  }

  /* Menú a pantalla completa (móvil) */
  .fmenu {
    display: none;
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 12px max(16px, var(--f-gutter)) 28px;
    border: 0;
    background: linear-gradient(#FFFFFF 60%, #F4F4F3);
    color: #111111;
  }

  .fmenu:popover-open {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 28px;
  }

  .fmenu__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 48px;
  }

  .fmenu__close {
    min-height: 44px;
    padding-inline: 18px;
    border: var(--f-hair) solid rgba(17, 17, 17, 0.18);
    border-radius: var(--f-r);
    background: transparent;
    color: inherit;
    font-size: 14px;
    cursor: pointer;
  }

  .fmenu__list {
    display: grid;
    align-content: center;
  }

  .fmenu__list > li > a {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 72px;
    padding: 14px 4px;
    border-bottom: var(--f-hair) solid rgba(17, 17, 17, 0.08);
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .fmenu__sub {
    display: flex;
    gap: 8px;
    padding: 0 4px 16px;
    border-bottom: var(--f-hair) solid rgba(17, 17, 17, 0.08);
  }

  .fmenu__list li:has(.fmenu__sub) > a { border-bottom: 0; }
  .fmenu__sub .chip { min-height: 44px; text-decoration: none; }
  .fmenu__sub .chip[aria-current='page'] { border-color: transparent; background: #111111; color: #FFFFFF; }

  .fmenu__list > li > a[aria-current='page']::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }

  .fmenu__direct { display: grid; gap: 10px; }

  .fmenu__wa,
  .fmenu__pro {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    border-radius: var(--f-r);
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
  }

  .fmenu__wa { background: #111111; color: #FFFFFF; }

  .fmenu__pro {
    border: var(--f-hair) solid rgba(191, 160, 106, 0.55);
    background: linear-gradient(135deg, rgba(217, 195, 148, 0.34), rgba(191, 160, 106, 0.22));
    color: #111111;
    cursor: pointer;
  }

  .fmenu__mail {
    justify-self: center;
    min-height: 32px;
    color: #555555;
    font-size: 16px;
  }

  @media (max-width: 959px) {
    .fnav__links { display: none; }
    .fnav__pro { display: none; }
    .fnav__bar { justify-content: space-between; }
    .fnav__menu { display: inline-flex; }
  }

  /* En móvil, el botón corto para que quepa junto al logotipo */
  @media (max-width: 520px) {
    .fnav__cta-long { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .fnav__cta-short { display: inline; }
    .fnav__cta { padding-inline: 16px; }
    .fnav__logo :global(.wordmark) { font-size: 19px; }
  }
</style>
