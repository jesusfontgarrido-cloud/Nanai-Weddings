---
/**
 * Historias: el selector entre tráilers (vídeo) y galerías (fotografía). Cada uno tiene su
 * página; la barra los ofrece también en un desplegable. Sin página por boda.
 */
import SiteLayout from '../../layouts/SiteLayout.astro';
import FlatPageHeader from '../../components/flat/FlatPageHeader.astro';
import FlatStoryKinds from '../../components/flat/FlatStoryKinds.astro';
import FlatContact from '../../components/flat/FlatContact.astro';
---

<SiteLayout
  title="Historias | Nanai Weddings · Bodas en Sevilla contadas en foto y vídeo"
  description="Tráilers y galerías de bodas reales en Sevilla y Andalucía, en fotografía y vídeo."
  path="/historias"
>
  <FlatPageHeader
    label="Historias"
    title={['Bodas que', 'hemos *contado*']}
    deck="En vídeo, los tráilers; en fotografía, las galerías por momentos. Elegid por dónde empezar."
  />
  <FlatStoryKinds />
  <FlatContact />
</SiteLayout>
