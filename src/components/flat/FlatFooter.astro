---
/**
 * Pie, mínimo: logotipo y el bloque NAP (nombre, base, teléfono y correo, igual que en el
 * perfil de Google: es lo que lee el SEO local) en una línea; debajo, los avisos legales
 * que pide la LSSI. Nada más.
 */
import FlatWordmark from './FlatWordmark.astro';
import { site } from '../../data/site';

const year = new Date().getFullYear();
---

<footer class="ffooter">
  <div class="wrap ffooter__inner">
    <div class="ffooter__main">
      <a class="ffooter__logo" href="/" aria-label="Nanai Weddings, inicio">
        <FlatWordmark />
      </a>
      <p class="ffooter__nap">
        <span>{site.base}</span>
        <a href={site.phoneHref}>{site.phone}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.instagram}>{site.instagramHandle}</a>
      </p>
    </div>

    <div class="ffooter__legal">
      <span>© {year} {site.name} · una línea de <a href={site.parent.url}>{site.parent.name}</a></span>
      <nav class="ffooter__links" aria-label="Legal">
        <a href="/aviso-legal">Aviso legal</a>
        <a href="/privacidad">Privacidad</a>
        <a href="/cookies">Cookies</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .ffooter {
    padding-block: clamp(40px, 5vw, 64px) 20px;
    background: linear-gradient(#FFFFFF, #F4F4F3);
    color: #111111;
  }

  .ffooter__inner { display: grid; gap: 28px; }

  .ffooter__main {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px 40px;
  }

  .ffooter__logo { display: inline-flex; align-items: center; min-height: 44px; color: inherit; text-decoration: none; }

  .ffooter__nap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 24px;
    color: var(--f-muted);
    font-size: 15px;
  }

  .ffooter__nap a,
  .ffooter__nap span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .ffooter__nap a { color: #111111; text-decoration: none; }
  .ffooter__nap a:hover { text-decoration: underline; text-underline-offset: 0.2em; }

  .ffooter__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 4px 24px;
    padding-top: 14px;
    border-top: var(--f-hair) solid rgba(17, 17, 17, 0.08);
    color: var(--f-dim);
    font-size: 14px;
  }

  .ffooter__legal a { color: inherit; }
  .ffooter__legal a:hover { color: #111111; }

  .ffooter__links { display: flex; flex-wrap: wrap; gap: 0 20px; }

  .ffooter__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
