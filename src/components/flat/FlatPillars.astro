---
/**
 * Tres razones en columnas, numeradas, con filete arriba («Qué ofrecemos» del dossier
 * para planners). Sin iconos: el número es el recurso.
 */
interface Props {
  items: { name: string; text: string }[];
  label?: string;
}

const { items, label = 'Qué ofrecemos' } = Astro.props;
---

<section class="sec fpillars" aria-label={label}>
  <div class="wrap">
    <ul class="fpillars__list" role="list" data-stagger>
      {
        items.map((item, i) => (
          <li class="fpillar">
            <span class="fpillar__num">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="h3 fpillar__name">{item.name}</h2>
            <p class="fpillar__text">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .fpillars { padding-top: 0; }

  .fpillars__list { display: grid; gap: 28px var(--f-gap); }

  .fpillar {
    display: grid;
    align-content: start;
    gap: 10px;
    padding-top: 18px;
    border-top: var(--f-hair) solid var(--f-line-strong);
  }

  .fpillar__num { color: var(--f-red-text); font-family: var(--font-type); font-size: 14px; }
  .fpillar__name { font-size: clamp(24px, 2.2vw, 32px); }
  .fpillar__text { max-width: 38ch; color: var(--f-muted); }

  @media (min-width: 900px) {
    .fpillars__list { grid-template-columns: repeat(3, 1fr); }
  }
</style>
