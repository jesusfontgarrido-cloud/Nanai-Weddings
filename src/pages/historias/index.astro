---
/**
 * Historias: galería de muestra. Todos los trabajos con el mismo peso: la portada en el
 * centro, fotogramas alrededor, y al pulsar, el tráiler o la galería. Sin página por boda.
 */
import SiteLayout from '../../layouts/SiteLayout.astro';
import FlatPageHeader from '../../components/flat/FlatPageHeader.astro';
import FlatShowcase from '../../components/flat/FlatShowcase.astro';
import FlatContact from '../../components/flat/FlatContact.astro';
---

<SiteLayout
  title="Historias | Nanai Weddings · Bodas en Sevilla contadas en foto y vídeo"
  description="Tráilers y galerías de bodas reales en Sevilla y Andalucía, en fotografía y vídeo."
  path="/historias"
>
  <FlatPageHeader
    label="Historias"
    title={['Bodas que', 'hemos *contado*']}
    deck="Tráilers y galerías de bodas reales. Pulsad en cualquiera para verla."
  />
  <FlatShowcase />
  <FlatContact />
</SiteLayout>
