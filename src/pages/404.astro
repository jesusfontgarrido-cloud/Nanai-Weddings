---
import BaseLayout from '../layouts/BaseLayout.astro';
import FlatMotion from '../components/flat/FlatMotion.astro';
import FlatNav from '../components/flat/FlatNav.astro';
import FlatFooter from '../components/flat/FlatFooter.astro';
---

<BaseLayout title="Página no encontrada | Nanai Weddings" noindex>
  <div class="flat">
    <FlatMotion />
    <FlatNav />
    <main id="contenido" class="sec f404">
      <div class="wrap f404__inner">
        <p class="label">Error 404 · toma falsa</p>
        <h1 class="display f404__title">Esta página <em class="accent">no</em> salió en el montaje</h1>
        <p class="lead f404__lead">Puede que el enlace haya cambiado. Volved al inicio o mirad las tarifas.</p>
        <p class="f404__links"><a class="btn" href="/">Ir al inicio</a> <a class="link" href="/tarifas">Ver tarifas →</a></p>
      </div>
    </main>
    <FlatFooter />
  </div>
</BaseLayout>

<style>
  .f404 { padding-top: clamp(140px, 22vh, 240px); }
  .f404__inner { display: grid; gap: 18px; }
  .f404__title { max-width: 14ch; font-size: clamp(48px, 7vw, 120px); }
  .f404__lead { color: var(--f-muted); }
  .f404__links { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; margin-top: 12px; }
</style>
