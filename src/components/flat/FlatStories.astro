---
/**
 * Bodas que hemos contado (home): banda oscura en tarjeta redondeada. Arriba, un tráiler
 * a lo ancho; debajo, tres trabajos en vertical, con pareja, lugar y fecha. Al pulsar uno
 * se abre su tráiler o su galería aquí mismo (FlatWorkViewer); sin JS, lleva a su página
 * (/historias/video#<id> o /historias/fotografia#<id>). Arriba a la derecha, las dos
 * puertas: tráilers y galerías. No hay página por boda.
 */
import { Picture } from 'astro:assets';
import FlatFilm from './FlatFilm.astro';
import FlatWorkViewer from './FlatWorkViewer.astro';
import { kindNames, workHref, works } from '../../data/stories';
import { storiesIntro, storyKinds } from '../../data/copy';
import trailerPoster from '../../assets/media/provisional/fotograma-chaqueta-bordada.jpg';

// Tres trabajos con portada, alternando tráiler y galería.
const shown = works.filter((work) => work.cover).slice(0, 3);
---

<section id="historias" class="sec sec--card tone-dark fstories" aria-labelledby="stories-title">
  <div class="wrap">
    <div class="fstories__head">
      <div class="fstories__titles">
        <h2 id="stories-title" class="h2" data-reveal="lines"><span>{storiesIntro.title}</span></h2>
        <p class="fstories__deck" data-reveal style="--i: 2">{storiesIntro.deck}</p>
      </div>
      <div class="fstories__doors" data-reveal>
        <a class="btn btn--glass btn--small" href={storyKinds.video.path}>Ver tráilers</a>
        <a class="btn btn--glass btn--small" href={storyKinds.foto.path}>Ver galerías de fotos</a>
      </div>
    </div>

    <div class="fstories__trailer" data-reveal="focus">
      <FlatFilm title="Tráiler · [Nombres de la pareja]" poster={trailerPoster} posterAlt="Fotograma: detalle de la chaqueta charra bordada en oro del novio" ratio="2.39 / 1" pendingWhat="Tráiler de una boda" />
    </div>

    <ul class="fstories__grid" role="list" data-stagger>
      {
        shown.map((work) => (
          <li>
            <a class="fstory" href={workHref(work)} data-open-dialog={`ver-${work.id}`}>
              <span class="fstory__media">
                <Picture
                  src={work.cover!.src}
                  formats={['avif', 'webp']}
                  widths={[480, 800, 1100]}
                  sizes="(min-width: 900px) 31vw, 92vw"
                  alt={work.cover!.alt}
                  loading="lazy"
                  style={work.cover!.focus ? `object-position: ${work.cover!.focus}` : undefined}
                />
                <span class="fstory__kind">{kindNames[work.kind]}</span>
              </span>
              <span class="fstory__caption">
                <span class="fstory__couple" data-pending={work.pending ? 'text' : undefined}>{work.couple}</span>
                <span class="label fstory__meta">{work.place} · {work.date}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  {shown.map((work) => <FlatWorkViewer work={work} />)}
</section>

<style>
  .fstories__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px 32px;
    margin-bottom: clamp(28px, 3.6vw, 48px);
  }

  .fstories__head h2 > span { display: block; }
  .fstories__titles { display: grid; gap: 10px; }
  .fstories__doors { display: flex; flex-wrap: wrap; gap: 8px; }
  .fstories__deck { max-width: 52ch; color: var(--f-muted); }

  .fstories__trailer { margin-bottom: clamp(32px, 4vw, 56px); }

  .fstories__grid {
    display: grid;
    gap: clamp(32px, 3.6vw, 52px) var(--f-gap);
  }

  .fstory {
    display: grid;
    gap: 14px;
    text-decoration: none;
  }

  .fstory__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--f-r-media);
    background: var(--f-surface-2);
  }

  .fstory__media :global(picture) { display: block; height: 100%; }

  .fstory__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1200ms var(--f-ease-out), filter 700ms var(--f-ease-out);
  }

  .fstory__kind {
    position: absolute;
    top: 14px;
    left: 14px;
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding-inline: 12px;
    border: var(--f-hair) solid rgba(255, 255, 255, 0.3);
    border-radius: var(--f-r);
    background: rgba(17, 17, 17, 0.36);
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    -webkit-backdrop-filter: var(--f-blur);
    backdrop-filter: var(--f-blur);
  }

  /* Al pasar por un trabajo, los demás se apagan un poco */
  @media (hover: hover) {
    .fstory:hover .fstory__media :global(img) { transform: scale(1.03); }
    .fstories__grid:has(.fstory:hover) .fstory:not(:hover) .fstory__media :global(img) { filter: brightness(0.6) grayscale(0.3); }
  }

  .fstory__caption { display: grid; gap: 4px; }

  .fstory__couple {
    font-family: var(--font-serif);
    font-size: clamp(24px, 2vw, 30px);
    font-size-adjust: ex-height 0.48;
    font-style: italic;
    font-weight: 500;
    line-height: 1.1;
  }

  .fstory__meta { color: var(--f-muted); }

  @media (min-width: 700px) {
    .fstories__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
