---
/**
 * Pie: el cierre en negro, como el de Nanai Studio. Arriba, los datos (con el bloque NAP
 * —nombre, base y teléfono— igual que en el perfil de Google: es lo que lee el SEO
 * local) y los enlaces; abajo, el logotipo a todo el ancho, cortado por el borde como un
 * rótulo que sale de plano. Los enlaces legales que pide la LSSI, al final.
 */
import FlatWordmark from './FlatWordmark.astro';
import { site } from '../../data/site';

const year = new Date().getFullYear();
---

<footer class="sec tone-dark ffooter">
  <div class="wrap ffooter__inner">
    <div class="ffooter__top">
      <dl class="ffooter__data">
        <div><dt class="label">Bodas</dt><dd>Fotografía y vídeo · una línea de <a href={site.parent.url}>{site.parent.name}</a></dd></div>
        <div><dt class="label">Base</dt><dd>{site.base} · {site.coordinates}</dd></div>
        <div>
          <dt class="label">Contacto</dt>
          <dd>
            <a href={site.phoneHref}>{site.phone}</a> · <a href={`mailto:${site.email}`}>{site.email}</a>
          </dd>
        </div>
      </dl>

      <nav class="ffooter__links" aria-label="Pie">
        <a class="chip" href="/historias">Historias</a>
        <a class="chip" href="/tarifas">Tarifas</a>
        <a class="chip" href="/tarifas#preguntas">Preguntas</a>
        <a class="chip" href="/profesionales">Profesionales</a>
        <a class="chip" href={site.instagram}>Instagram</a>
        <a class="chip" href={site.whatsapp}>WhatsApp</a>
      </nav>
    </div>

    <div class="ffooter__legal">
      <a href="/aviso-legal">Aviso legal</a>
      <a href="/privacidad">Política de privacidad</a>
      <a href="/cookies">Cookies</a>
      <span class="readout ffooter__end"><span class="readout__key">©</span>{year} {site.name}</span>
    </div>
  </div>

  <div class="ffooter__logo-wrap" aria-hidden="true">
    <FlatWordmark tone="paper" size="footer" />
  </div>
</footer>

<style>
  .ffooter {
    padding-bottom: 0;
    overflow: hidden;
  }

  .ffooter__inner {
    display: grid;
    gap: clamp(40px, 5vw, 72px);
  }

  .ffooter__top {
    display: grid;
    gap: 36px;
  }

  .ffooter__data {
    display: grid;
    gap: 12px;
    margin: 0;
  }

  .ffooter__data div { display: grid; gap: 2px; }
  .ffooter__data dd { margin: 0; color: var(--f-on-surface); }
  .ffooter__data a { display: inline-block; padding-block: 7px; text-decoration: none; }
  .ffooter__data a:hover { text-decoration: underline; text-underline-offset: 0.2em; }

  .ffooter__links {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: 8px;
  }

  .ffooter__links .chip:hover {
    border-color: transparent;
    background: var(--f-inverse);
    color: var(--f-on-inverse);
  }

  .ffooter__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    padding-top: 18px;
    border-top: var(--f-hair) solid var(--f-line);
    color: var(--f-muted);
    font-size: 15px;
  }

  .ffooter__legal a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
  }

  .ffooter__end { margin-left: auto; }

  /* El logotipo sale de plano por abajo */
  .ffooter__logo-wrap {
    width: 100%;
    max-width: var(--f-maxw);
    margin: clamp(32px, 4vw, 56px) auto 0;
    padding-inline: var(--f-gutter);
    height: 0.86em;
    overflow: hidden;
    font-size: clamp(38px, 9.8vw, 164px);
    line-height: 1;
  }

  .ffooter__logo-wrap :global(.wordmark) { font-size: 1em; }

  @media (min-width: 900px) {
    .ffooter__top { grid-template-columns: 1fr 1fr; align-items: start; }
    .ffooter__links { justify-content: flex-end; }
  }
</style>
