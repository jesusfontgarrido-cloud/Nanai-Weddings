---
/**
 * Cabecera de las páginas interiores, como las páginas del dossier («Estilo» y debajo
 * «cinematográfico y dinámico»): la primera parte del titular en League Spartan y la
 * segunda, debajo, en Playfair cursiva y en tono medio (del mismo tamaño aparente).
 * Entradilla y, si hace falta, un botón.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import FlatEm from './FlatEm.astro';

interface Props {
  /** Nombre de la sección para los lectores de pantalla (no se muestra). */
  label: string;
  /** Titular en dos partes: la segunda, debajo y en cursiva. */
  title: [string, string];
  deck?: string | string[];
  cta?: { href: string; label: string };
  /** Foto a lo ancho bajo el titular. */
  image?: { src: ImageMetadata; alt: string; credit?: string };
}

const { label, title, deck, cta, image } = Astro.props;
const decks = deck ? (Array.isArray(deck) ? deck : [deck]) : [];
---

<section class="sec fpage-sec" aria-label={label}>
  <div class="wrap fpage">
    <h1 class="display fpage__title" data-reveal="lines">
      <span><FlatEm text={title[0]} /></span>
      <span class="accent tone-2 fpage__title-2">{title[1].replace(/\*/g, '')}</span>
    </h1>

    {
      decks.length > 0 && (
        <div class="fpage__deck" data-reveal style="--i: 3">
          {decks.map((paragraph) => (
            <p class="lead">{paragraph}</p>
          ))}
        </div>
      )
    }

    {
      cta && (
        <div class="fpage__actions" data-reveal style="--i: 4">
          <a class="btn" href={cta.href}>
            {cta.label}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      )
    }

    {
      image && (
        <figure class="fpage__photo" data-reveal="focus">
          <Picture src={image.src} formats={['avif', 'webp']} widths={[800, 1280, 1920, 2400]} sizes="100vw" alt={image.alt} loading="eager" />
          {image.credit && <span class="photo-credit">Foto {image.credit}</span>}
        </figure>
      )
    }
  </div>
</section>

<style>
  .fpage-sec {
    padding-top: clamp(120px, 18vh, 200px);
    padding-bottom: clamp(48px, 6vw, 96px);
  }

  .fpage { display: grid; gap: 18px; }

  .fpage__title { font-size: clamp(46px, 7.4vw, 132px); }
  .fpage__title > span { display: block; }

  .fpage__title-2 { line-height: 1.02; }

  .fpage__photo {
    position: relative;
    margin: clamp(24px, 3vw, 48px) 0 0;
    overflow: hidden;
    border-radius: var(--f-r-card);
    aspect-ratio: 21 / 9;
    background: var(--f-surface-3);
  }

  .fpage__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 699px) {
    .fpage__photo { aspect-ratio: 4 / 3; }
  }

  .fpage__deck {
    display: grid;
    gap: 14px;
    max-width: 62ch;
    margin-top: clamp(8px, 1.2vw, 16px);
    color: var(--f-muted);
  }

  .fpage__actions { margin-top: 32px; }
</style>
