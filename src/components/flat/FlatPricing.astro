---
/**
 * Tarifas como carpetas apiladas (referencia: details.so, tarjetas que asoman unas detrás
 * de otras). Cada servicio es una carpeta con su pestaña: Fotografía delante, Vídeo y
 * Foto + vídeo detrás. Al pulsar una pestaña, esa carpeta pasa al frente y las demás se
 * quedan detrás, asomando.
 *
 * Dentro de cada carpeta: el servicio y su precio (en dos tonos), lo que incluye y, a la
 * derecha, las imágenes de ejemplo (home) o el dossier de ese servicio (/tarifas; con
 * foto + vídeo, los dos).
 *
 * Dos modos:
 * · «compact» (home): «Consultar fecha» (ventana emergente) y «Calcular con extras».
 * · «full» (/tarifas): debajo, invitados y extras, y un resumen con el total que abre la
 *   misma ventana emergente con la selección.
 *
 * Sin JS: las pestañas son radios y la carpeta elegida se ve delante igualmente.
 * Los precios salen de src/data/pricing.ts.
 */
import { Picture } from 'astro:assets';
import FlatEm from './FlatEm.astro';
import FlatDateDialog from './FlatDateDialog.astro';
import { crewRule, euros, extras, groupNames, guestOptions, services, terms, type Group } from '../../data/pricing';
import { dossiers } from '../../data/dossiers';
import { pricingIntro } from '../../data/copy';
import still from '../../assets/media/provisional/fotograma-novia-buganvilla.jpg';
import sheet1 from '../../assets/media/provisional/hoja/foto-01.jpg';
import sheet2 from '../../assets/media/provisional/hoja/foto-02.jpg';
import sheet3 from '../../assets/media/provisional/hoja/foto-03.jpg';
import sheet4 from '../../assets/media/provisional/hoja/foto-04.jpg';

interface Props {
  mode?: 'compact' | 'full';
  id?: string;
  /** Titular propio (la página de tarifas ya tiene el suyo arriba). */
  heading?: boolean;
}

const { mode = 'compact', id = 'tarifas', heading = true } = Astro.props;
const full = mode === 'full';
const start = services[0];
const sheet = [sheet1, sheet2, sheet3, sheet4];
const groups: Group[] = ['video', 'foto'];

const data = {
  services: services.map(({ id, name, price, groups }) => ({ id, name, price, groups })),
  extras: extras.map(({ id, group, name, price, crew }) => ({ id, group, name, price, crew: Boolean(crew) })),
  crewRule,
};

const fullHref = (service: string) => `/tarifas?servicio=${service}#calculadora`;
const serviceDossiers = (serviceId: string) =>
  serviceId === 'foto' ? [dossiers.foto] : serviceId === 'video' ? [dossiers.video] : [dossiers.foto, dossiers.video];
---

<section id={id} class:list={['sec', 'fprice', `fprice--${mode}`]} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    {
      heading ? (
        <div class="fprice__head">
          <p class="label" data-reveal>{pricingIntro.label}</p>
          <h2 id={`${id}-title`} class="h2" data-reveal="lines"><span><FlatEm text={pricingIntro.title} /></span></h2>
          <p class="lead fprice__deck" data-reveal style="--i: 2">{pricingIntro.deck}</p>
        </div>
      ) : (
        <h2 id={`${id}-title`} class="visually-hidden">Calculadora de tarifas</h2>
      )
    }

    <form class="fprice__form" data-pricing data-mode={mode} action="#" method="get">
      <script type="application/json" data-pricing-data set:html={JSON.stringify(data)} />

      <!-- Las carpetas -->
      <fieldset class="ffolders" data-folders>
        <legend class="visually-hidden">Servicio</legend>
        {
          services.map((service, i) => (
            <div class="ffolder" data-folder={service.id} data-depth={i === 0 ? 0 : i} style={`--i: ${i}`}>
              <label class="ffolder__tab">
                <input type="radio" name="servicio" value={service.id} checked={service.id === start.id} />
                <span>{service.name}</span>
              </label>

              <div class="ffolder__body" data-folder-body>
                <div class="ffolder__info">
                  <p class="label ffolder__label">Tarifa</p>
                  <h3 class="ffolder__name">
                    <span>{service.name}</span>
                    <span class="ffolder__price">{euros(service.price)} €</span>
                  </h3>
                  <ul class="ffolder__list" role="list">
                    <li>{service.crew} toda la jornada</li>
                    {service.deliver.map((item) => (
                      <li>{item}</li>
                    ))}
                    <li>Entrega en {terms.deliveryMonths} meses como máximo</li>
                  </ul>
                  {!full && (
                    <div class="ffolder__actions">
                      <button class="btn btn--light" type="button" data-open-dialog="date-dialog">
                        Consultar fecha
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                      </button>
                      <a class="btn ffolder__ghost" href={fullHref(service.id)}>Calcular con extras</a>
                    </div>
                  )}
                </div>

                <div class:list={['ffolder__media', `ffolder__media--${service.id}`]}>
                  {full ? (
                    <ul class="ffolder__dossiers" role="list">
                      {serviceDossiers(service.id).map((dossier) => (
                        <li>
                          <a class="fdoc" href={dossier.href} download>
                            <span class="fdoc__sheet" aria-hidden="true">
                              <span>PDF</span>
                              <i /><i /><i />
                            </span>
                            <span class="fdoc__text">
                              <strong>{dossier.title}</strong>
                              <span>{dossier.contents}</span>
                            </span>
                            <span class="fdoc__cta">
                              Descargar
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12M6 10l6 6 6-6M5 20h14" /></svg>
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <>
                      {service.id !== 'video' && (
                        <div class="ffolder__sheet">
                          {sheet.map((src) => (
                            <Picture src={src} formats={['avif', 'webp']} widths={[240, 480]} sizes="(min-width: 1024px) 14vw, 40vw" alt="" loading="lazy" />
                          ))}
                        </div>
                      )}
                      {service.id !== 'foto' && (
                        <div class="ffolder__film">
                          <Picture src={still} formats={['avif', 'webp']} widths={[640, 1000, 1400]} sizes="(min-width: 1024px) 40vw, 90vw" alt="" loading="lazy" />
                        </div>
                      )}
                    </>
                  )}
                </div>
              </div>
            </div>
          ))
        }
      </fieldset>

      {
        full && (
          <div class="fcustom">
            <div class="fcustom__controls">
              <fieldset class="fcustom__guests">
                <legend class="fcustom__legend">¿Cuántos invitados?</legend>
                <div class="fcustom__chips">
                  {guestOptions.map((option) => (
                    <label class="fchip">
                      <input type="radio" name="invitados" value={option.id} data-crew={option.crew} />
                      <span class="chip">{option.label}</span>
                    </label>
                  ))}
                </div>
                <p class="note fcustom__crew" data-crew-note hidden />
              </fieldset>

              <div class="fcustom__extras">
                <p class="fcustom__legend">Extras</p>
                {groups.map((group) => (
                  <fieldset class="fextras" data-group={group}>
                    <legend class="label fextras__title">{groupNames[group]}</legend>
                    {extras
                      .filter((extra) => extra.group === group)
                      .map((extra) => (
                        <label class="fextra">
                          <input type="checkbox" name="extras" value={extra.id} data-extra={extra.id} />
                          <span class="fextra__box" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg>
                          </span>
                          <span class="fextra__name">
                            {extra.name}
                            {extra.crew && <span class="tag fextra__badge" data-crew-badge hidden />}
                            {extra.featured && <span class="tag tag--soft">Destacado</span>}
                          </span>
                          <span class="fextra__price">+{euros(extra.price)} €</span>
                          <span class="fextra__text">{extra.text}</span>
                        </label>
                      ))}
                  </fieldset>
                ))}
              </div>
            </div>

            <aside class="fsummary" aria-label="Vuestra estimación">
              <p class="label">Vuestra estimación</p>
              <p class="price fsummary__price" aria-hidden="true">
                <span class="odo" data-odo>{euros(start.price)}</span><span class="price__eur">€</span>
              </p>
              <p class="visually-hidden" aria-live="polite" data-total-text>Total estimado: {euros(start.price)} euros</p>
              <ul class="fsummary__list" role="list" data-summary-list>
                <li><span>{start.name}</span><span>{euros(start.price)} €</span></li>
              </ul>
              <p class="note fsummary__warning" data-summary-warning hidden>
                Con {crewRule.requiredFrom} invitados o más es obligatorio un segundo fotógrafo/a u operador/a: si no, no se llega a todo como se merece.
              </p>
              <button class="btn fsummary__cta" type="button" data-open-dialog="date-dialog">
                Consultar fecha con esta selección
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </button>
            </aside>
          </div>
        )
      }

      {
        full && (
          <div class="fprice__dock" data-dock aria-hidden="true">
            <span class="fprice__dock-total">
              <span class="label">Estimación</span>
              <strong data-dock-total>{euros(start.price)} €</strong>
            </span>
            <button class="btn btn--small" type="button" tabindex="-1" data-open-dialog="date-dialog">Consultar fecha</button>
          </div>
        )
      }
    </form>
  </div>

  <FlatDateDialog />
</section>

<script>
  type Data = {
    services: { id: string; name: string; price: number; groups: string[] }[];
    extras: { id: string; group: string; name: string; price: number; crew: boolean }[];
    crewRule: { recommendedFrom: number; requiredFrom: number; price: number };
  };

  const euros = (value: number) => String(value).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /** Contador: cada cifra es una tira 0–9 que rueda hasta su número. */
  const odometer = (node: HTMLElement, value: number) => {
    const chars = [...euros(value)];
    const current = [...node.children].map((child) => (child as HTMLElement).dataset.char ?? '');
    const sameShape = current.length === chars.length && current.every((char, i) => (char === '.') === (chars[i] === '.'));
    if (!sameShape) {
      node.replaceChildren(
        ...chars.map((char, i) => {
          const col = document.createElement('span');
          if (char === '.') {
            col.className = 'odo__sep';
            col.dataset.char = '.';
            col.textContent = '.';
            return col;
          }
          col.className = 'odo__col';
          col.dataset.char = '0';
          col.style.setProperty('--k', String(i));
          const strip = document.createElement('span');
          strip.className = 'odo__strip';
          strip.innerHTML = '0123456789'.split('').map((d) => `<span>${d}</span>`).join('');
          col.append(strip);
          return col;
        }),
      );
      void node.offsetWidth;
    }
    chars.forEach((char, i) => {
      if (char === '.') return;
      const col = node.children[i] as HTMLElement;
      col.dataset.char = char;
      col.style.setProperty('--d', char);
    });
  };

  document.querySelectorAll<HTMLFormElement>('[data-pricing]').forEach((form) => {
    const raw = form.querySelector('[data-pricing-data]')?.textContent;
    if (!raw) return;
    const data = JSON.parse(raw) as Data;
    const full = form.dataset.mode === 'full';
    const folders = [...form.querySelectorAll<HTMLElement>('[data-folder]')];
    const odo = form.querySelector<HTMLElement>('[data-odo]');
    const totalText = form.querySelector<HTMLElement>('[data-total-text]');
    const dockTotal = form.querySelector<HTMLElement>('[data-dock-total]');
    const list = form.querySelector<HTMLElement>('[data-summary-list]');
    const warning = form.querySelector<HTMLElement>('[data-summary-warning]');
    const crewNote = form.querySelector<HTMLElement>('[data-crew-note]');

    form.classList.add('is-live');
    form.addEventListener('submit', (event) => event.preventDefault());

    // Preselección desde la URL (?servicio=video), al venir de la home.
    const wanted = new URLSearchParams(location.search).get('servicio');
    const wantedInput = wanted ? form.querySelector<HTMLInputElement>(`input[name="servicio"][value="${CSS.escape(wanted)}"]`) : null;
    if (wantedInput) wantedInput.checked = true;

    const label = (extra: Data['extras'][number], service: Data['services'][number]) =>
      `${extra.name}${service.groups.length > 1 ? ` (${extra.group === 'video' ? 'vídeo' : 'foto'})` : ''}`;

    const update = () => {
      const serviceId = form.querySelector<HTMLInputElement>('input[name="servicio"]:checked')?.value ?? data.services[0].id;
      const service = data.services.find((s) => s.id === serviceId) ?? data.services[0];

      // Carpetas: la elegida delante; las demás detrás, en su orden.
      const order = [serviceId, ...folders.map((f) => f.dataset.folder ?? '').filter((id) => id !== serviceId)];
      folders.forEach((folder) => {
        const depth = order.indexOf(folder.dataset.folder ?? '');
        folder.dataset.depth = String(depth);
        const body = folder.querySelector<HTMLElement>('[data-folder-body]');
        if (body) body.inert = depth !== 0;
      });

      // Invitados: se informa, nunca se marca nada por la persona.
      const guestInput = form.querySelector<HTMLInputElement>('input[name="invitados"]:checked');
      const crewLevel = guestInput?.dataset.crew ?? 'none';

      form.querySelectorAll<HTMLElement>('[data-group]').forEach((group) => {
        group.hidden = !service.groups.includes(group.dataset.group ?? '');
      });

      const chosen: Data['extras'] = [];
      let crewMissing = false;
      data.extras.forEach((extra) => {
        const input = form.querySelector<HTMLInputElement>(`input[data-extra="${extra.id}"]`);
        if (!input) return;
        const available = service.groups.includes(extra.group);
        if (extra.crew) {
          const badge = input.closest('label')?.querySelector<HTMLElement>('[data-crew-badge]');
          if (badge) {
            badge.hidden = !available || crewLevel === 'none';
            badge.textContent = crewLevel === 'required' ? 'Obligatorio' : 'Recomendado';
            badge.classList.toggle('tag--soft', crewLevel !== 'required');
          }
          if (available && crewLevel === 'required' && !input.checked) crewMissing = true;
        }
        if (available && input.checked) chosen.push(extra);
      });

      if (crewNote) {
        crewNote.hidden = crewLevel === 'none';
        crewNote.textContent =
          crewLevel === 'required'
            ? `Con ${data.crewRule.requiredFrom} invitados o más es obligatorio un segundo fotógrafo/a u operador/a (+${data.crewRule.price} €): si no, no se llega a todo como se merece. Lo añadís vosotros abajo.`
            : `A partir de ${data.crewRule.recommendedFrom} invitados os recomendamos un segundo fotógrafo/a u operador/a (+${data.crewRule.price} €).`;
      }
      if (warning) warning.hidden = !crewMissing;

      const total = service.price + chosen.reduce((sum, extra) => sum + extra.price, 0);

      if (full) {
        if (odo) odometer(odo, total);
        if (totalText) totalText.textContent = `Total estimado: ${euros(total)} euros`;
        if (dockTotal) dockTotal.textContent = `${euros(total)} €`;
        if (list) {
          list.replaceChildren(
            ...[{ name: service.name, price: service.price }, ...chosen.map((extra) => ({ name: label(extra, service), price: extra.price }))].map((row) => {
              const li = document.createElement('li');
              const a = document.createElement('span');
              const b = document.createElement('span');
              a.textContent = row.name;
              b.textContent = `${euros(row.price)} €`;
              li.append(a, b);
              return li;
            }),
          );
        }
      }

      // La selección viaja a la ventana emergente y al formulario de contacto.
      const names = chosen.map((extra) => label(extra, service));
      const guestsLabel = guestInput ? guestInput.closest('label')?.textContent?.trim() : '';
      const summary = full
        ? `${service.name}${names.length ? ` + ${names.join(', ')}` : ''} · ${euros(total)} € (estimación)${guestsLabel ? ` · ${guestsLabel} invitados` : ''}`
        : `${service.name} · ${euros(service.price)} €`;
      document.dispatchEvent(new CustomEvent('nanai:selection', { detail: { service: serviceId, summary, guests: guestInput?.value, detailed: full } }));
    };

    form.addEventListener('change', update);
    update();
    requestAnimationFrame(() => form.classList.add('is-ready'));

    // Barra fija de móvil (tarifas): solo mientras se ven los extras.
    const dock = form.querySelector<HTMLElement>('[data-dock]');
    const extrasBox = form.querySelector('.fcustom__extras');
    if (dock && extrasBox && 'IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => dock.classList.toggle('is-shown', entry.isIntersecting), { threshold: 0 }).observe(extrasBox);
    }

    if (reduceMotion) form.classList.add('is-still');
  });
</script>

<style>
  .fprice__head {
    display: grid;
    gap: 14px;
    margin-bottom: clamp(36px, 4.4vw, 64px);
  }

  .fprice__head h2 > span { display: block; }
  .fprice__deck { max-width: 46ch; color: var(--f-muted); }

  .fprice__form { display: grid; gap: clamp(32px, 4vw, 56px); }

  /* ── Carpetas ───────────────────────────────────────────────── */
  .ffolders {
    --tab-h: 50px;
    --peek: 14px;
    --tab-step: clamp(104px, 21vw, 220px);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: calc(var(--tab-h) + 2 * var(--peek)) 0 0;
    border: 0;
    min-width: 0;
  }

  .ffolder {
    --folder: #17191C;
    grid-area: 1 / 1;
    position: relative;
    z-index: 3;
    color: #FFFFFF;
    transform-origin: 50% 0;
    transition:
      transform 760ms var(--f-ease-out),
      filter 760ms var(--f-ease-out);
  }

  /* Detrás: un tono medio más claro, asomando por arriba y un poco más estrecha */
  .ffolder[data-depth='1'] { --folder: #2E3136; z-index: 2; transform: translateY(calc(var(--peek) * -1)) scale(0.975); }
  .ffolder[data-depth='2'] { --folder: #464A50; z-index: 1; transform: translateY(calc(var(--peek) * -2)) scale(0.95); }

  /* Sin JS: la elegida delante (las demás, detrás a la misma altura) */
  .ffolders:not(.is-live *) .ffolder:has(input:checked) { z-index: 4; }

  .ffolder__tab {
    position: absolute;
    bottom: 100%;
    left: calc(24px + var(--i) * var(--tab-step));
    display: inline-flex;
    align-items: center;
    height: var(--tab-h);
    padding-inline: 22px;
    border-radius: 18px 18px 0 0;
    background: var(--folder);
    color: inherit;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.01em;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 760ms var(--f-ease-out), color var(--f-dur) var(--f-ease);
  }

  .ffolder[data-depth='1'] .ffolder__tab,
  .ffolder[data-depth='2'] .ffolder__tab { color: rgba(255, 255, 255, 0.78); }
  .ffolder[data-depth='1'] .ffolder__tab:hover,
  .ffolder[data-depth='2'] .ffolder__tab:hover { color: #FFFFFF; }

  .ffolder__tab input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .ffolder__tab:has(input:focus-visible) { outline: 2px solid #111111; outline-offset: 3px; }

  .ffolder__body {
    display: grid;
    gap: clamp(28px, 3vw, 48px);
    height: 100%;
    padding: clamp(24px, 3.4vw, 48px);
    border-radius: var(--f-r-card);
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0) 45%),
      var(--folder);
    box-shadow: 0 -1px 0 rgba(255, 255, 255, 0.06) inset, var(--f-shadow);
    transition: background-color 760ms var(--f-ease-out);
  }

  /* Las carpetas de detrás no ocupan sitio: la altura la marca la de delante */
  .ffolder:not([data-depth='0']) .ffolder__body { position: absolute; inset: 0; overflow: hidden; }

  /* El contenido de las carpetas de detrás no se ve; el de la de delante entra con un fundido */
  .ffolder__body > * { transition: opacity 520ms var(--f-ease-out) 160ms, transform 700ms var(--f-ease-out) 120ms; }
  .ffolder:not([data-depth='0']) .ffolder__body > * { opacity: 0; transform: translateY(10px); transition-delay: 0ms; }
  .ffolders:not(.is-live *) .ffolder:not(:has(input:checked)) .ffolder__body > * { opacity: 0; }

  .ffolder__info { display: grid; align-content: start; gap: 18px; }
  .ffolder__label { color: rgba(255, 255, 255, 0.62); }

  /* Servicio y precio en dos tonos, como la referencia */
  .ffolder__name {
    display: grid;
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 76px);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .ffolder__price { color: #9A9A96; }

  .ffolder__list { display: grid; }

  .ffolder__list li {
    padding-block: 11px;
    border-top: var(--f-hair) solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.88);
    font-size: 16px;
    line-height: 1.4;
  }

  .ffolder__actions { display: flex; flex-wrap: wrap; gap: 10px; padding-top: 6px; }

  .ffolder__ghost {
    border-color: rgba(255, 255, 255, 0.32);
    background: rgba(255, 255, 255, 0.06);
    color: #FFFFFF;
  }

  .ffolder__ghost:hover { background: rgba(255, 255, 255, 0.14); }

  /* Imágenes de ejemplo */
  .ffolder__media { display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; align-content: center; min-width: 0; }

  .ffolder__sheet {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  .ffolder__sheet :global(picture),
  .ffolder__sheet :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 12px;
  }

  .ffolder__film :global(picture),
  .ffolder__film :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2.39 / 1;
    object-fit: cover;
    border-radius: 14px;
  }

  /* Dossieres (en /tarifas, en lugar de las imágenes) */
  .ffolder__dossiers { display: grid; gap: 12px; }

  .fdoc {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 18px;
    padding: 16px 18px;
    border: var(--f-hair) solid rgba(255, 255, 255, 0.16);
