---
/**
 * Calculadora de tarifas. La idea sale del oficio: elegir un servicio es como montar una
 * línea de tiempo de edición. Cada servicio y cada extra es una pista (V1, F1, dron…)
 * sobre los momentos del día; el total corre como un contador.
 *
 * Al elegir:
 * · el recuadro de enfoque (AF) salta al servicio elegido y el resto se desenfoca un poco;
 * · el precio rueda como un contador;
 * · la pantalla cambia con un rack focus (hoja de contactos para foto, fotograma 2.39:1
 *   para vídeo, las dos cosas para el pack);
 * · las pistas entran en la línea de tiempo y el cabezal rojo la recorre.
 *
 * Dos modos: «compact» (home: servicio y precio, con enlace a la completa) y «full»
 * (/tarifas: invitados y extras). Sin JS: radios y casillas normales y el precio de
 * partida a la vista. Con movimiento reducido: todo cambia al instante.
 *
 * Los precios salen de src/data/pricing.ts. La selección se manda al formulario de
 * contacto de la página (evento «nanai:selection»).
 */
import { Picture } from 'astro:assets';
import FlatEm from './FlatEm.astro';
import { crewRule, euros, extras, groupNames, guestOptions, services, stages, terms, type Group } from '../../data/pricing';
import { pricingIntro } from '../../data/copy';
import still from '../../assets/media/provisional/fotograma-novia-buganvilla.jpg';
import sheet1 from '../../assets/media/provisional/hoja/foto-01.jpg';
import sheet2 from '../../assets/media/provisional/hoja/foto-02.jpg';
import sheet3 from '../../assets/media/provisional/hoja/foto-03.jpg';
import sheet4 from '../../assets/media/provisional/hoja/foto-04.jpg';
import sheet5 from '../../assets/media/provisional/hoja/foto-05.jpg';
import sheet6 from '../../assets/media/provisional/hoja/foto-06.jpg';

interface Props {
  mode?: 'compact' | 'full';
  id?: string;
  /** Titular propio (la página de tarifas ya tiene el suyo arriba). */
  heading?: boolean;
}

const { mode = 'compact', id = 'tarifas', heading = true } = Astro.props;
const full = mode === 'full';
const start = services.find((service) => service.featured) ?? services[0];
const sheet = [sheet1, sheet2, sheet3, sheet4, sheet5, sheet6];
const groups: Group[] = ['video', 'foto'];
const dayExtras = extras.filter((extra) => extra.slot.kind === 'day');

const trackCode: Record<string, string> = {
  'operador-extra': 'V2',
  'camara-extra': 'V3',
  'dron-video': 'V4',
  'same-day-edit': 'SDE',
  podcast: 'A2',
  'fotografo-extra': 'F2',
  'dron-foto': 'F3',
};

const data = {
  services: services.map(({ id, name, price, groups }) => ({ id, name, price, groups })),
  extras: extras.map(({ id, group, name, price, crew, slot }) => ({ id, group, name, price, crew: Boolean(crew), slot: slot.kind })),
  crewRule,
  booking: terms.booking,
  freeKm: terms.freeKm,
};

const startPrice = euros(start.price);
/** En móvil la regla no cabe entera: nombres cortos. */
const shortStages = ['Prep.', 'Ceremonia', 'Cóctel', 'Banquete', 'Fiesta'];
const fullHref = (service: string) => `/tarifas?servicio=${service}#calculadora`;
---

<section id={id} class:list={['sec', 'fprice', `fprice--${mode}`]} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    {
      heading ? (
        <div class="fprice__head">
          <p class="label" data-reveal>{pricingIntro.label}</p>
          <h2 id={`${id}-title`} class="h2" data-reveal="lines"><span><FlatEm text={pricingIntro.title} /></span></h2>
          <p class="lead fprice__deck" data-reveal style="--i: 2">{pricingIntro.deck}</p>
        </div>
      ) : (
        <h2 id={`${id}-title`} class="visually-hidden">Calculadora de tarifas</h2>
      )
    }

    <form class="fprice__grid" data-pricing data-mode={mode} action={full ? '#contacto' : '/tarifas'} method="get">
      <script type="application/json" data-pricing-data set:html={JSON.stringify(data)} />

      <div class="fprice__controls">
        <fieldset class="fprice__packs" data-packs>
          <legend class="fprice__legend"><span class="fprice__step">01</span> Qué queréis contar</legend>
          <div class="fprice__packlist" data-packlist>
            <span class="fprice__af" aria-hidden="true" data-af><i></i><i></i><i></i><i></i></span>
            {
              services.map((service) => (
                <label class="fpack">
                  <input type="radio" name="servicio" value={service.id} checked={service.id === start.id} />
                  <span class="fpack__name">{service.name}</span>
                  <span class="fpack__price">{euros(service.price)} €</span>
                  <span class="fpack__crew">{service.crew}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        {
          !full && (
            <div class="fprice__includes">
              {services.map((service) => (
                <ul class="fincludes" role="list" data-for={service.id} hidden={service.id !== start.id}>
                  <li>{service.crew}, {service.id === 'pack' ? 'coordinados' : 'toda la jornada'}</li>
                  {service.deliver.map((item) => (
                    <li>{item}</li>
                  ))}
                  <li>Entrega en {terms.deliveryMonths} meses como máximo</li>
                </ul>
              ))}
            </div>
          )
        }

        {
          full && (
            <fieldset class="fprice__guests">
              <legend class="fprice__legend"><span class="fprice__step">02</span> Cuántos invitados</legend>
              <div class="fprice__chips">
                {guestOptions.map((option, i) => (
                  <label class="fchip">
                    <input type="radio" name="invitados" value={option.id} checked={i === 0} data-crew={option.crew} />
                    <span class="chip">{option.label}</span>
                  </label>
                ))}
              </div>
              <p class="note fprice__crew-note" data-crew-note aria-live="polite">
                Con más de {crewRule.recommendedFrom} invitados os recomendamos un segundo fotógrafo/a u operador/a; desde {crewRule.requiredFrom}, es obligatorio.
              </p>
            </fieldset>
          )
        }

        {
          full && (
            <div class="fprice__extras">
              <p class="fprice__legend"><span class="fprice__step">03</span> Extras</p>
              {groups.map((group) => (
                <fieldset class="fextras" data-group={group}>
                  <legend class="label fextras__title">{groupNames[group]}</legend>
                  {extras
                    .filter((extra) => extra.group === group)
                    .map((extra) => (
                      <label class:list={['fextra', { 'fextra--featured': extra.featured }]} data-extra-row={extra.id}>
                        <input type="checkbox" name="extras" value={extra.id} data-extra={extra.id} />
                        <span class="fextra__box" aria-hidden="true">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg>
                        </span>
                        <span class="fextra__name">
                          {extra.name}
                          {extra.crew && <span class="fextra__badge" data-crew-badge hidden />}
                        </span>
                        <span class="fextra__price">
                          +{euros(extra.price)} €{extra.unit && <span class="fextra__unit"> {extra.unit}</span>}
                        </span>
                        <span class="fextra__text">{extra.text}</span>
                      </label>
                    ))}
                </fieldset>
              ))}
            </div>
          )
        }

        {
          !full && (
            <p class="fprice__more" data-reveal>
              <span class="muted">Dron, álbum, Same Day Edit, preboda…</span>
              <a class="link" href={fullHref(start.id)} data-full-link>Añadir extras y calcular →</a>
            </p>
          )
        }
      </div>

      <div class="fprice__result tone-bone">
        <!-- Pantalla: lo que os llevaríais, con un rack focus al cambiar -->
        <div class="fscreen" data-screen={start.id} aria-hidden="true">
          <div class="fscreen__layer fscreen__sheet">
            {
              sheet.map((src, i) => (
                <figure class="fscreen__cell">
                  <Picture src={src} formats={['avif', 'webp']} widths={[200, 400]} sizes="160px" alt="" loading="lazy" />
                  <figcaption>{String(i + 12).padStart(2, '0')}A</figcaption>
                </figure>
              ))
            }
          </div>
          <div class="fscreen__layer fscreen__film">
            <Picture src={still} formats={['avif', 'webp']} widths={[640, 1000, 1300]} sizes="(min-width: 1024px) 40vw, 92vw" alt="" loading="lazy" />
            <span class="fscreen__rec"><span class="rec-dot"></span>REC</span>
            <span class="fscreen__tc">00:04:12:08</span>
          </div>
          <span class="fscreen__caption" data-screen-caption>{start.crew}</span>
        </div>

        <div class="fprice__total">
          <p class="label fprice__total-label">{full ? 'Vuestra estimación' : 'Desde'}</p>
          <p class="price fprice__price" aria-hidden="true">
            <span class="odo" data-odo>{startPrice}</span><span class="price__eur">€</span>
          </p>
          <p class="visually-hidden" aria-live="polite" data-total-text>Total: {startPrice} euros</p>
          <p class="note fprice__reserve" data-reserve>
            Reserva: {euros(terms.booking * 2)} € · Hasta {terms.freeKm} km de Dos Hermanas, sin desplazamiento
          </p>
        </div>

        <!-- Línea de tiempo: la jornada y sus pistas (orientativo) -->
        <div class="ftl" data-tl>
          <div class="ftl__ruler" aria-hidden="true">
            {stages.map((stage, i) => <span data-short={shortStages[i]}><span>{stage}</span></span>)}
          </div>
          <div class="ftl__tracks">
            <span class="ftl__head" aria-hidden="true" data-head></span>
            <div class="ftl__track is-on" data-track="foto" style="--from: 0; --to: 4" data-for="foto pack">
              <span class="ftl__clip ftl__clip--main"><b>F1</b> Fotógrafo/a</span>
            </div>
            <div class="ftl__track is-on" data-track="video" style="--from: 0; --to: 4" data-for="video pack">
              <span class="ftl__clip ftl__clip--main"><b>V1</b> Operador/a</span>
            </div>
            {
              dayExtras.map((extra) =>
                extra.slot.kind === 'day' ? (
                  <div class="ftl__track" data-track={extra.id} style={`--from: ${extra.slot.from}; --to: ${extra.slot.to}`}>
                    <span class:list={['ftl__clip', { 'ftl__clip--key': extra.featured }]}>
                      <b>{trackCode[extra.id]}</b> {extra.name}
                    </span>
                  </div>
                ) : null,
              )
            }
          </div>
          <p class="ftl__aside" data-aside hidden></p>
          <p class="visually-hidden" data-tl-text>Cobertura: toda la jornada, de los preparativos a una hora después del inicio de la barra libre.</p>
        </div>

        <!-- Lo que incluye cada servicio (en la completa, aquí; en la de la home, bajo los servicios) -->
        {
          full && (
            <div class="fprice__includes">
              {services.map((service) => (
                <ul class="fincludes" role="list" data-for={service.id} hidden={service.id !== start.id}>
                  <li>{service.crew}, {service.id === 'pack' ? 'coordinados' : 'toda la jornada'}</li>
                  {service.deliver.map((item) => (
                    <li>{item}</li>
                  ))}
                  <li>Entrega en {terms.deliveryMonths} meses como máximo</li>
                </ul>
              ))}
            </div>
          )
        }

        <div class="fprice__actions">
          {
            full ? (
              <a class="btn btn--red fprice__cta" href="#contacto" data-to-contact>
                Consultar fecha con esta selección
              </a>
            ) : (
              <>
                <a class="btn fprice__cta" href={fullHref(start.id)} data-full-link>
                  Calcular con extras
                </a>
                <a class="link" href="#contacto" data-to-contact>Consultar fecha →</a>
              </>
            )
          }
        </div>
      </div>

      {
        full && (
          <div class="fprice__dock" data-dock aria-hidden="true">
            <span class="fprice__dock-total">
              <span class="label">Estimación</span>
              <strong data-dock-total>{startPrice} €</strong>
            </span>
            <a class="btn btn--red" href="#contacto" tabindex="-1" data-to-contact>Consultar fecha</a>
          </div>
        )
      }
    </form>
  </div>
</section>

<script>
  type Data = {
    services: { id: string; name: string; price: number; groups: string[] }[];
    extras: { id: string; group: string; name: string; price: number; crew: boolean; slot: 'day' | 'other' | 'delivery' }[];
    crewRule: { recommendedFrom: number; requiredFrom: number; price: number };
    booking: number;
    freeKm: number;
  };

  const euros = (value: number) => String(value).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /**
   * Contador: cada cifra es una tira 0–9 que rueda hasta su número. Con `hold`, monta las
   * tiras en cero y espera (la primera vez rueda al entrar la calculadora en pantalla).
   */
  const odometer = (node: HTMLElement, value: number, hold = false) => {
    const text = euros(value);
    const chars = [...text];
    const current = [...node.children].map((child) => (child as HTMLElement).dataset.char ?? '');
    const sameShape = current.length === chars.length && current.every((char, i) => (char === '.') === (chars[i] === '.'));

    if (!sameShape) {
      node.replaceChildren(
        ...chars.map((char, i) => {
          const col = document.createElement('span');
          if (char === '.') {
            col.className = 'odo__sep';
            col.dataset.char = '.';
            col.textContent = '.';
            return col;
          }
          col.className = 'odo__col';
          col.dataset.char = '0';
          col.style.setProperty('--k', String(i));
          const strip = document.createElement('span');
          strip.className = 'odo__strip';
          strip.innerHTML = '0123456789'.split('').map((d) => `<span>${d}</span>`).join('');
          col.append(strip);
          return col;
        }),
      );
      // Un fotograma después, para que la tira arranque desde 0 y ruede.
      void node.offsetWidth;
    }

    if (hold) return;
    chars.forEach((char, i) => {
      const col = node.children[i] as HTMLElement;
      if (char === '.') return;
      col.dataset.char = char;
      col.style.setProperty('--d', char);
    });
  };

  document.querySelectorAll<HTMLFormElement>('[data-pricing]').forEach((form) => {
    const raw = form.querySelector('[data-pricing-data]')?.textContent;
    if (!raw) return;
    const data = JSON.parse(raw) as Data;
    const full = form.dataset.mode === 'full';

    const packs = form.querySelector<HTMLElement>('[data-packlist]');
    const af = form.querySelector<HTMLElement>('[data-af]');
    const odo = form.querySelector<HTMLElement>('[data-odo]');
    const totalText = form.querySelector<HTMLElement>('[data-total-text]');
    const reserve = form.querySelector<HTMLElement>('[data-reserve]');
    const screen = form.querySelector<HTMLElement>('[data-screen]');
    const caption = form.querySelector<HTMLElement>('[data-screen-caption]');
    const head = form.querySelector<HTMLElement>('[data-head]');
    const aside = form.querySelector<HTMLElement>('[data-aside]');
    const dockTotal = form.querySelector<HTMLElement>('[data-dock-total]');
    const crewNote = form.querySelector<HTMLElement>('[data-crew-note]');
    const fullLinks = form.querySelectorAll<HTMLAnchorElement>('[data-full-link]');

    form.classList.add('is-live');
    form.addEventListener('submit', (event) => event.preventDefault());

    // Preselección desde la URL (?servicio=video) al venir de la home.
    const wanted = new URLSearchParams(location.search).get('servicio');
    const wantedInput = wanted ? form.querySelector<HTMLInputElement>(`input[name="servicio"][value="${CSS.escape(wanted)}"]`) : null;
    if (wantedInput) wantedInput.checked = true;

    let lastService = '';
    // El contador espera a que la calculadora se vea para rodar por primera vez.
    let seen = reduceMotion || !('IntersectionObserver' in window);

    const moveAf = () => {
      const checked = packs?.querySelector<HTMLInputElement>('input:checked')?.closest('label');
      if (!packs || !af || !checked) return;
      const box = checked.getBoundingClientRect();
      const origin = packs.getBoundingClientRect();
      af.style.setProperty('--x', `${box.left - origin.left}px`);
      af.style.setProperty('--y', `${box.top - origin.top}px`);
      af.style.setProperty('--w', `${box.width}px`);
      af.style.setProperty('--h', `${box.height}px`);
    };

    const update = (animate = true) => {
      const serviceId = form.querySelector<HTMLInputElement>('input[name="servicio"]:checked')?.value ?? data.services[0].id;
      const service = data.services.find((s) => s.id === serviceId) ?? data.services[0];
      const serviceChanged = serviceId !== lastService;
      lastService = serviceId;

      // Invitados → segundo fotógrafo/operador recomendado u obligatorio.
      const crewLevel = form.querySelector<HTMLInputElement>('input[name="invitados"]:checked')?.dataset.crew ?? 'none';

      // Grupos de extras que admite el servicio.
      form.querySelectorAll<HTMLElement>('[data-group]').forEach((group) => {
        const on = service.groups.includes(group.dataset.group ?? '');
        group.hidden = !on;
      });

      const chosen: Data['extras'] = [];
      data.extras.forEach((extra) => {
        const input = form.querySelector<HTMLInputElement>(`input[data-extra="${extra.id}"]`);
        if (!input) return;
        const available = service.groups.includes(extra.group);
        const badge = input.closest('label')?.querySelector<HTMLElement>('[data-crew-badge]');

        if (extra.crew) {
          const required = available && crewLevel === 'required';
          if (required) input.checked = true;
          if (input.disabled && !required) input.checked = false;
          input.disabled = required;
          if (badge) {
            badge.hidden = !available || crewLevel === 'none';
            badge.textContent = crewLevel === 'required' ? 'Obligatorio' : 'Recomendado';
          }
        }
        if (available && input.checked) chosen.push(extra);
      });

      const total = service.price + chosen.reduce((sum, extra) => sum + extra.price, 0);
      const reservation = data.booking * service.groups.length;

      if (odo) odometer(odo, total, !seen);
      if (totalText) totalText.textContent = `Total ${full ? 'estimado' : 'desde'}: ${euros(total)} euros`;
      if (dockTotal) dockTotal.textContent = `${euros(total)} €`;
      if (reserve) reserve.textContent = `Reserva: ${euros(reservation)} € · Hasta ${data.freeKm} km de Dos Hermanas, sin desplazamiento`;
      if (crewNote) crewNote.classList.toggle('is-strong', crewLevel !== 'none');

      // Pantalla: rack focus entre la hoja de contactos, el fotograma o los dos.
      if (screen && serviceChanged) {
        screen.dataset.screen = serviceId;
        if (animate && !reduceMotion) {
          screen.classList.remove('is-racking');
          void screen.offsetWidth;
          screen.classList.add('is-racking');
        }
      }
      if (caption) {
        const crew = { foto: 'Un fotógrafo/a', video: 'Un operador/a', pack: 'Fotógrafo/a + operador/a' } as Record<string, string>;
        const extraCrew = chosen.filter((extra) => extra.crew).length;
        caption.textContent = `${crew[serviceId] ?? ''}${extraCrew ? ` + ${extraCrew} más` : ''}`;
      }

      // Pistas de la línea de tiempo.
      form.querySelectorAll<HTMLElement>('[data-track]').forEach((track) => {
        const key = track.dataset.track ?? '';
        const forList = track.dataset.for?.split(' ');
        const on = forList ? forList.includes(serviceId) : chosen.some((extra) => extra.id === key);
        track.classList.toggle('is-on', on);
      });

      const otherDay = chosen.filter((extra) => extra.slot === 'other').map((extra) => `${extra.name}${service.groups.length > 1 ? ` (${extra.group === 'video' ? 'vídeo' : 'foto'})` : ''}`);
      const delivery = chosen.filter((extra) => extra.slot === 'delivery').map((extra) => extra.name);
      if (aside) {
        const parts = [otherDay.length ? `Otro día: ${otherDay.join(', ')}` : '', delivery.length ? `Con la entrega: ${delivery.join(', ')}` : ''].filter(Boolean);
        aside.textContent = parts.join(' · ');
        aside.hidden = parts.length === 0;
      }

      // El cabezal rojo recorre la jornada.
      if (head && animate && !reduceMotion) {
        head.classList.remove('is-playing');
        void head.offsetWidth;
        head.classList.add('is-playing');
      }

      // Lo que incluye.
      form.querySelectorAll<HTMLElement>('ul[data-for]').forEach((list) => {
        const on = list.dataset.for === serviceId;
        if (on && list.hidden && animate && !reduceMotion) {
          list.classList.remove('is-in');
          requestAnimationFrame(() => list.classList.add('is-in'));
        }
        list.hidden = !on;
      });

      fullLinks.forEach((link) => (link.href = `/tarifas?servicio=${serviceId}#calculadora`));
      moveAf();

      // La selección viaja al formulario de contacto de la página.
      const names = chosen.map((extra) => `${extra.name}${service.groups.length > 1 ? ` (${extra.group === 'video' ? 'vídeo' : 'foto'})` : ''}`);
      const summary = `${service.name}${names.length ? ` + ${names.join(', ')}` : ''} · ${euros(total)} € (${full ? 'estimación' : 'desde'})`;
      const guests = form.querySelector<HTMLInputElement>('input[name="invitados"]:checked')?.value;
      document.dispatchEvent(new CustomEvent('nanai:selection', { detail: { service: serviceId, summary, guests, detailed: full } }));
    };

    form.addEventListener('change', () => update());
    window.addEventListener('resize', moveAf);
    if (document.fonts) void document.fonts.ready.then(moveAf);
    update(false);
    requestAnimationFrame(() => form.classList.add('is-ready'));

    if (!seen) {
      const result = form.querySelector('.fprice__price');
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          observer.disconnect();
          seen = true;
          update(false);
        },
        { threshold: 0.6 },
      );
      if (result) observer.observe(result);
    }

    // Barra fija de móvil: solo mientras la calculadora está en pantalla.
    const dock = form.querySelector<HTMLElement>('[data-dock]');
    if (dock && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => dock.classList.toggle('is-shown', entry.isIntersecting), { threshold: 0 });
      const controls = form.querySelector('.fprice__extras');
      if (controls) observer.observe(controls);
    }
  });
</script>

<style>
  .fprice__head {
    display: grid;
    gap: 14px;
    margin-bottom: clamp(36px, 4.4vw, 64px);
  }

  .fprice__head h2 > span { display: block; }
  .fprice__deck { max-width: 46ch; color: var(--f-muted); }

  .fprice__grid {
    position: relative;
    display: grid;
    gap: clamp(28px, 3.4vw, 56px);
  }

  .fprice__controls {
    display: grid;
    align-content: start;
    gap: clamp(28px, 3vw, 44px);
  }

  .fprice__packs,
  .fprice__guests,
  .fextras {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .fprice__legend {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 0;
    margin-bottom: 14px;
    font-size: 15px;
    font-weight: 600;
