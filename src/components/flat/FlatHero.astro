---
/**
 * Hero: la imagen a toda la pantalla y el titular centrado, en blanco sobre una sombra
 * suave que se concentra en el centro. Abajo, la imagen se funde en blanco con un degradado
 * largo, así se pasa a la primera sección sin corte.
 * Primera línea en League Spartan; la segunda, en Playfair cursiva (del mismo tamaño
 * aparente), con un filete fino que se dibuja bajo «contamos».
 *
 * PROVISIONAL: fotograma del dossier para planners (2880 × 1226). Lo ideal es un bucle de
 * vídeo sin sonido de 8–15 s (≤ 6 MB, con póster): ver docs/recursos-pendientes.md. Si se
 * pasa `loop`, se usa el vídeo y la foto queda de póster.
 */
import { getImage } from 'astro:assets';
import heroImage from '../../assets/media/provisional/fotograma-beso-chaqueta-charra.jpg';
import heroTall from '../../assets/media/provisional/fotograma-beso-vertical.jpg';
import { hero } from '../../data/copy';
import { site } from '../../data/site';

interface Props {
  /** Bucle del hero (mp4/webm en /public/media). */
  loop?: string;
}

const { loop } = Astro.props;

// En pantallas verticales, un recorte vertical propio (si no, la foto apaisada se estira).
const wide = [1024, 1440, 1920, 2560];
const tall = [540, 690];
const set = async (format: 'avif' | 'webp') => ({
  wide: (await Promise.all(wide.map((width) => getImage({ src: heroImage, format, width })))).map((img, i) => `${img.src} ${wide[i]}w`).join(', '),
  tall: (await Promise.all(tall.map((width) => getImage({ src: heroTall, format, width })))).map((img, i) => `${img.src} ${tall[i]}w`).join(', '),
});
const avif = await set('avif');
const webp = await set('webp');
const fallback = await getImage({ src: heroImage, format: 'jpg', width: 1920 });
const portrait = '(max-aspect-ratio: 2/3)';
const wideSizes = '(max-aspect-ratio: 3/2) 150vh, 100vw';
---

<section class="fhero" aria-labelledby="hero-title" data-hero>
  <figure class="fhero__photo" data-reveal="focus">
    {
      loop ? (
        <video src={loop} poster={fallback.src} autoplay muted loop playsinline preload="metadata" aria-hidden="true" />
      ) : (
        <picture>
          <source media={portrait} type="image/avif" srcset={avif.tall} sizes="100vw" />
          <source media={portrait} type="image/webp" srcset={webp.tall} sizes="100vw" />
          <source type="image/avif" srcset={avif.wide} sizes={wideSizes} />
          <source type="image/webp" srcset={webp.wide} sizes={wideSizes} />
          <img
            src={fallback.src}
            width={heroImage.width}
            height={heroImage.height}
            alt="Beso de los novios entre burbujas a la salida de la ceremonia; él lleva una chaqueta charra bordada en oro"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      )
    }
  </figure>
  <span class="fhero__shade" aria-hidden="true"></span>

  <div class="wrap fhero__content">
    <h1 id="hero-title" class="fhero__h1">
      <span class="label fhero__label" data-reveal>{hero.label}</span>
      <span class="display fhero__title" data-reveal="lines" style="--i: 1">
        <span>{hero.claim[0]}</span>
        <span class="accent">nosotros la <span class="fhero__line">contamos</span></span>
      </span>
    </h1>

    <div class="fhero__actions" data-reveal style="--i: 4">
      <a class="btn btn--light" href="#tarifas">
        Ver tarifas
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
      <a class="btn btn--glass" href={site.whatsapp}>WhatsApp</a>
    </div>
  </div>
</section>

<style>
  .fhero {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    background: #FFFFFF;
    color: #FFFFFF;
  }

  .fhero__photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    margin: 0;
    background: #1A1B1D;
  }

  .fhero__photo :global(picture),
  .fhero__photo :global(img),
  .fhero__photo video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 44% 30%;
  }

  /*
   * Sombra centrada (para que el blanco se lea) y, abajo, el fundido a blanco: la imagen
   * se disuelve en la primera sección.
   */
  .fhero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, rgba(255, 255, 255, 0) 70%, rgba(255, 255, 255, 0.55) 88%, #FFFFFF 100%),
      radial-gradient(60% 46% at 50% 50%, rgba(10, 10, 10, 0.5), rgba(10, 10, 10, 0.18) 70%, rgba(10, 10, 10, 0) 100%),
      linear-gradient(to bottom, rgba(10, 10, 10, 0.28), rgba(10, 10, 10, 0) 30%);
  }

  .fhero__content {
    --f-on-surface: #FFFFFF;
    display: grid;
    justify-items: center;
    gap: 26px;
    padding-top: 120px;
    padding-bottom: clamp(120px, 18vh, 200px);
    text-align: center;
  }

  .fhero__h1 {
    display: grid;
    justify-items: center;
    gap: 18px;
    font-weight: inherit;
  }

  .fhero__label { color: rgba(255, 255, 255, 0.86); }

  .fhero__title {
    font-size: clamp(44px, 7vw, 124px);
    color: #FFFFFF;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.18);
  }

  .fhero__title > span { display: block; }
  .fhero__title .accent { line-height: 1.04; }

  /* «contamos»: un filete fino que se dibuja de izquierda a derecha */
  .fhero__line {
    padding-bottom: 0.04em;
    background: linear-gradient(rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.85)) 0 100% / 100% 0.035em no-repeat;
  }

  html.motion .fhero__line {
    background-size: 0 0.035em;
    transition: background-size 1400ms var(--f-ease-out) 1000ms;
  }

  html.motion .is-in .fhero__line { background-size: 100% 0.035em; }

  .fhero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 6px;
  }

  @media (max-width: 699px) {
    .fhero__photo :global(img) { object-position: 50% 30%; }
    .fhero__title { font-size: clamp(40px, 11.4vw, 60px); }
    .fhero__content { padding-bottom: 140px; }
  }
</style>
