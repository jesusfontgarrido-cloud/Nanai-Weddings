---
/**
 * Barra superior. Blanca, con filete abajo: logotipo a la izquierda, las páginas en el
 * centro (la activa, subrayada en amarillo) y a la derecha dos botones: «Profesionales»
 * (contorno: la puerta para wedding planners, fincas y proveedores) y «Consultar fecha»
 * (negro; en móvil, «Hablemos»).
 * En móvil: «Menú» abre una hoja a pantalla completa con WhatsApp a mano.
 */
import { site } from '../../data/site';
import FlatWordmark from './FlatWordmark.astro';

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/historias', label: 'Historias' },
  { href: '/tarifas', label: 'Tarifas' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (path === href || (href !== '/' && path.startsWith(`${href}/`)) ? ('page' as const) : undefined);
const onPro = path.startsWith('/profesionales');
// En la página de profesionales, el botón principal lleva a su propio contacto.
const cta = onPro ? { href: '#contacto', label: 'Hablemos' } : { href: path === '/' ? '#contacto' : '/#contacto', label: 'Consultar fecha' };
---

<header class="fnav">
  <div class="fnav__bar">
    <a class="fnav__logo" href="/" aria-label="Nanai Weddings, inicio">
      <FlatWordmark />
    </a>

    <nav class="fnav__links" aria-label="Principal">
      <ul role="list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={current(link.href)}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="fnav__actions">
      <a class="fnav__pro" href="/profesionales" aria-current={onPro ? 'page' : undefined}>Profesionales</a>
      <a class="fnav__cta" href={cta.href}>
        <span class="fnav__cta-long">{cta.label}</span><span class="fnav__cta-short" aria-hidden="true">Hablemos</span>
      </a>
      <button class="fnav__menu" type="button" popovertarget="flat-menu">Menú</button>
    </div>
  </div>
</header>

<div id="flat-menu" class="fmenu" popover>
  <div class="fmenu__head">
    <FlatWordmark />
    <button class="fmenu__close" type="button" popovertarget="flat-menu" popovertargetaction="hide">Cerrar</button>
  </div>

  <nav aria-label="Principal (móvil)">
    <ul class="fmenu__list" role="list">
      {
        links.map((link) => (
          <li>
            <a href={link.href} aria-current={current(link.href)}>{link.label}</a>
          </li>
        ))
      }
      <li><a href="/#contacto">Consultar fecha</a></li>
    </ul>
  </nav>

  <div class="fmenu__direct">
    <a class="fmenu__pro" href="/profesionales">
      <span>¿Wedding planner, finca o proveedor?</span>
      <strong>Profesionales →</strong>
    </a>
    <a class="fmenu__wa" href={site.whatsapp}>Escribidnos por WhatsApp</a>
    <a class="fmenu__mail" href={`mailto:${site.email}`}>{site.email}</a>
  </div>
</div>

<script>
  // Un enlace de ancla no cierra el popover por sí solo.
  const menu = document.getElementById('flat-menu');
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      try {
        (menu as HTMLElement & { hidePopover(): void }).hidePopover();
      } catch {
        // Navegador sin popover o menú ya cerrado.
      }
    });
  });
</script>

<style>
  .fnav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
  }

  .fnav__bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 64px;
    padding: 8px var(--f-gutter);
    border-bottom: var(--f-hair) solid rgba(17, 17, 17, 0.1);
    background: rgba(255, 255, 255, 0.96);
    color: #111111;
    view-transition-name: fnav;
  }

  .fnav__logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #111111;
    text-decoration: none;
  }

  .fnav__links { flex: 1; }

  .fnav__links ul {
    display: flex;
    justify-content: center;
    gap: 28px;
  }

  .fnav__links a,
  .fnav__pro,
  .fnav__cta,
  .fnav__menu {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
  }

  /* Enlaces: la página activa, subrayada en amarillo, como con rotulador */
  .fnav__links a {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #444444;
    text-decoration: none;
    transition: color var(--f-dur) var(--f-ease);
  }

  .fnav__links a::after {
    content: '';
    position: absolute;
    left: -2px;
    right: -2px;
    bottom: 12px;
    z-index: -1;
    height: 7px;
    background: var(--f-yellow);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 420ms var(--f-ease-out);
  }

  .fnav__links a:hover,
  .fnav__links a[aria-current='page'] { color: #111111; }

  .fnav__links a:hover::after,
  .fnav__links a[aria-current='page']::after { transform: scaleX(1); }

  .fnav__links a[aria-current='page'] { font-weight: 600; }

  .fnav__actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .fnav__pro {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding-inline: 16px;
    border: var(--f-hair) solid rgba(17, 17, 17, 0.3);
    color: #111111;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color var(--f-dur) var(--f-ease), background-color var(--f-dur) var(--f-ease);
  }

  .fnav__pro:hover { border-color: #111111; }
  .fnav__pro[aria-current='page'] { border-color: #111111; background: var(--f-yellow); }

  /* El único botón relleno de la barra */
  .fnav__cta {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding-inline: 18px;
    background: #111111;
    color: #FFFFFF;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--f-dur) var(--f-ease), color var(--f-dur) var(--f-ease);
  }

  .fnav__cta:hover { background: var(--f-yellow); color: #111111; }
  .fnav__cta-short { display: none; }

  .fnav__menu {
    display: none;
    align-items: center;
    min-height: 42px;
    padding-inline: 14px;
    border: var(--f-hair) solid rgba(17, 17, 17, 0.3);
    background: transparent;
    color: #111111;
    cursor: pointer;
  }

  /* Menú a pantalla completa (móvil) */
  .fmenu {
    display: none;
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 12px max(16px, var(--f-gutter)) 28px;
    border: 0;
    background: #FFFFFF;
    color: #111111;
  }

  .fmenu:popover-open {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 28px;
  }

  .fmenu__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 48px;
  }

  .fmenu__close {
    min-height: 44px;
    padding-inline: 16px;
    border: var(--f-hair) solid rgba(17, 17, 17, 0.3);
    background: transparent;
    color: inherit;
    font-size: 14px;
    cursor: pointer;
  }

  .fmenu__list {
    display: grid;
    align-content: center;
    border-top: var(--f-hair) solid rgba(17, 17, 17, 0.12);
  }

  .fmenu__list a {
    display: flex;
    align-items: center;
    min-height: 72px;
    padding: 14px 4px;
    border-bottom: var(--f-hair) solid rgba(17, 17, 17, 0.12);
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .fmenu__list a[aria-current='page'] {
    background: linear-gradient(var(--f-yellow), var(--f-yellow)) 4px 70% / 40px 8px no-repeat;
    padding-left: 56px;
  }

  .fmenu__direct { display: grid; gap: 12px; }

  .fmenu__pro {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 6px 16px;
    min-height: 56px;
    padding: 12px 16px;
    background: var(--f-yellow);
    color: #111111;
    font-size: 15px;
    text-decoration: none;
  }

  .fmenu__wa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    background: #111111;
    color: #FFFFFF;
    font-size: 17px;
    font-weight: 600;
    text-decoration: none;
  }

  .fmenu__mail {
    justify-self: center;
    min-height: 32px;
    color: #555555;
    font-size: 16px;
  }

  @media (max-width: 959px) {
    .fnav__links { display: none; }
    .fnav__pro { display: none; }
    .fnav__bar { justify-content: space-between; }
    .fnav__menu { display: inline-flex; }
  }

  /* En móvil, el botón corto para que quepa junto al logotipo */
  @media (max-width: 520px) {
    .fnav__cta-long { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .fnav__cta-short { display: inline; }
    .fnav__cta { padding-inline: 14px; }
    .fnav__logo :global(.wordmark) { font-size: 19px; }
  }
</style>
